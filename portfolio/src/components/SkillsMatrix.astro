---
import { SKILLS, SKILL_COUNT } from '../data/skills';

/*
 * The capability index.
 *
 * The site could previously only answer "what does he know" by making the reader
 * open six case studies and assemble the tech badges themselves. This is the
 * answer stated once, in one place, scannable in a few seconds.
 *
 * Set in the sans face, not the mono annotation face. Every other list on the
 * site is 11px uppercase mono, and at this length that setting stops being a
 * texture and becomes an obstacle — this is the longest list on the site and the
 * one most likely to be read in a hurry. Only the group labels keep the mono
 * treatment, which is enough to place it in the same family as everything else.
 */

interface Props {
  /** Rendered as an h2 by default; the About page nests it under one. */
  headingLevel?: 'h2' | 'h3';
  id?: string;
}

const { headingLevel = 'h2', id } = Astro.props;
const Heading = headingLevel;
---

<section class="skills" id={id}>
  <header
    class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b-2 border-figure pb-4"
  >
    <div>
      <p class="annotation text-accent">// Capabilities</p>
      <Heading class="mt-1 font-display text-2xl font-extrabold tracking-[-0.02em] uppercase sm:text-3xl">
        What I work with
      </Heading>
    </div>
    <p class="annotation">{SKILL_COUNT} verified competencies · grouped by domain</p>
  </header>

  <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      SKILLS.map((group, idx) => (
        <div class="skills-card card-solid flex h-full flex-col border border-rule p-5 sm:p-6 transition-colors duration-150 hover:border-figure/50">
          <div class="flex items-center justify-between border-b border-rule pb-3">
            <h3 class="font-sans text-xs font-semibold uppercase tracking-wider text-figure">
              {group.label}
            </h3>
            <span class="font-mono text-[11px] text-figure-muted">
              0{idx + 1}
            </span>
          </div>

          <ul class="mt-4 flex flex-wrap gap-2" role="list">
            {group.items.map((item) => (
              <li class="skill-pill inline-flex items-center border border-rule/80 bg-ground-raised px-2.5 py-1 font-mono text-[0.75rem] text-figure transition-all duration-150 hover:border-accent hover:text-figure">
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .skills-card {
    border-radius: 0;
  }
  .skill-pill {
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
</style>
