---
import { SCHEMA_TREE, SCHEMA_EDGES, nodeById } from '../data/schema-tree';

/*
 * The finished blueprint, as a static SVG.
 *
 * This is NOT an error state. It gives reduced-motion and low-power visitors a
 * designed resting state rather than a broken one: they get the finished
 * blueprint, which stands on its own.
 *
 * It is also what renders with JavaScript disabled, and what paints first for
 * everyone — the 3D canvas fades in over the top of it only once Three.js has
 * loaded. Nothing here costs a network request: no <img>, no font, no texture.
 *
 * Geometry is computed from src/data/schema-tree.ts, the same file the Three.js
 * island reads, so the two views are structurally identical by construction.
 */

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

// Grid units → SVG user units. The horizontal scale keeps the outermost leaf
// plates clear of the sheet edge and the corner registration marks.
const X = (gx: number) => 460 + gx * 124;
const Y = (gy: number) => 300 - gy * 90;

// Leaf plates are narrower than the 124-unit leaf pitch, leaving a visible gap.
const PLATE_W = (depth: number) => (depth === 2 ? 108 : depth === 1 ? 130 : 120);
const PLATE_H = 40;

/** Right-angle connector routing, as an architectural drawing would run it. */
const busY = (parentDepth: number) => (parentDepth === 0 ? 210 : 400);

const edges = SCHEMA_EDGES.map(([parentId, childId]) => {
  const parent = nodeById(parentId)!;
  const child = nodeById(childId)!;
  const y0 = Y(parent.gy) + PLATE_H / 2;
  const y1 = Y(child.gy) - PLATE_H / 2;
  const bus = busY(parent.depth);
  return `M ${X(parent.gx)} ${y0} V ${bus} H ${X(child.gx)} V ${y1}`;
});

const depthLabels = [
  { gy: 2, text: 'depth 0' },
  { gy: 0, text: 'depth 1' },
  { gy: -2, text: 'depth 2' },
];
---

<svg
  class={`blueprint-svg ${className}`}
  viewBox="0 0 920 580"
  role="img"
  aria-labelledby="blueprint-title blueprint-desc"
  preserveAspectRatio="xMidYMid meet"
>
  <title id="blueprint-title">Schema tree — exploded assembly</title>
  <desc id="blueprint-desc">
    An architectural blueprint of a schema tree. A root node inherits downward
    into three branches — Systems, Product and Craft — which in turn carry seven
    projects: SchemaShift, TalentHub, Hotel Tamarind Tree, EasyApply, Prompta,
    Horologia and Luna.
  </desc>

  {/* Corner registration marks */}
  <g class="bp-rule">
    <path d="M 12 12 H 44 M 12 12 V 44" />
    <path d="M 908 12 H 876 M 908 12 V 44" />
    <path d="M 12 568 H 44 M 12 568 V 536" />
    <path d="M 908 568 H 876 M 908 568 V 536" />
  </g>

  {/* Depth guide rules */}
  {
    depthLabels.map(({ gy, text }) => (
      <g>
        <line class="bp-guide" x1="34" y1={Y(gy)} x2="886" y2={Y(gy)} />
        {/*
          Lifted clear of the plate band. At depth 2 the outermost plate reaches
          x≈49, so a label sitting on the datum line collides with it and the
          trailing digit disappears behind the plate.
        */}
        <text class="bp-annotation" x="34" y={Y(gy) - PLATE_H / 2 - 10}>
          {text}
        </text>
      </g>
    ))
  }

  {/* Inheritance connectors */}
  <g class="bp-edge">
    {edges.map((d) => <path d={d} />)}
  </g>

  {/* Node plates */}
  {
    SCHEMA_TREE.map((node) => {
      const w = PLATE_W(node.depth);
      const cx = X(node.gx);
      const cy = Y(node.gy);
      return (
        <g class={`bp-node bp-node--d${node.depth}`}>
          <rect x={cx - w / 2} y={cy - PLATE_H / 2} width={w} height={PLATE_H} />
          {/* Construction ticks on the plate corners */}
          <path
            class="bp-tick"
            d={`M ${cx - w / 2} ${cy - PLATE_H / 2 + 8} V ${cy - PLATE_H / 2} H ${cx - w / 2 + 8}
                M ${cx + w / 2 - 8} ${cy + PLATE_H / 2} H ${cx + w / 2} V ${cy + PLATE_H / 2 - 8}`}
          />
          <text class="bp-label" x={cx} y={cy + 4}>
            {node.short}
          </text>
        </g>
      );
    })
  }

  {/* Title block, as a drawing sheet carries */}
  <g class="bp-titleblock">
    <rect x="644" y="510" width="264" height="58" />
    <line x1="644" y1="534" x2="908" y2="534" />
    <line x1="776" y1="510" x2="776" y2="568" />
    <text class="bp-annotation" x="656" y="527">title</text>
    <text class="bp-annotation" x="788" y="527">sheet</text>
    <text class="bp-label bp-label--sm" x="656" y="555">SCHEMA TREE</text>
    <text class="bp-label bp-label--sm" x="788" y="555">01</text>
  </g>

  <text class="bp-annotation" x="34" y="555">inherits downward</text>
</svg>

<style>
  /* Sized by its container — in the hero that is an absolutely-positioned box. */
  .blueprint-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .blueprint-svg text {
    font-family: var(--font-mono);
    fill: var(--color-figure-muted);
  }

  .bp-annotation {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .bp-label {
    font-size: 13px;
    letter-spacing: 0.1em;
    text-anchor: middle;
    fill: var(--color-figure);
  }

  .bp-label--sm {
    font-size: 12px;
    text-anchor: start;
  }

  /* SCHEMASHIFT is the longest label; it must sit inside a 108-unit plate. */
  .bp-node--d2 .bp-label {
    font-size: 11px;
  }

  .bp-rule path,
  .bp-titleblock rect,
  .bp-titleblock line {
    stroke: var(--color-rule);
    stroke-width: 1;
    fill: none;
  }

  .bp-guide {
    stroke: var(--color-rule);
    stroke-width: 1;
    stroke-dasharray: 2 6;
  }

  .bp-edge path {
    stroke: var(--color-accent);
    stroke-width: 1.25;
    fill: none;
    opacity: 0.75;
  }

  .bp-node rect {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.25;
  }

  .bp-node--d0 rect {
    stroke-width: 2;
  }

  .bp-tick {
    stroke: var(--color-figure-muted);
    stroke-width: 1.25;
    fill: none;
  }
</style>
