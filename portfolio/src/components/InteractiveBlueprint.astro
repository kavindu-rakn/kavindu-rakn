---
/*
 * Interactive Blueprint Instrument.
 *
 * Replaces the static ASCII cover image with an expansive, interactive drafting canvas.
 * - Ships zero external dependencies (pure Canvas2D vector math).
 * - High-DPI Retina resolution support.
 * - Pauses requestAnimationFrame when out of viewport via IntersectionObserver.
 * - Respects prefers-reduced-motion with an instant static technical render.
 * - Reactive to light (gold) and dark (lime) theme CSS variables automatically.
 */
---

<div class="blueprint-instrument" aria-hidden="true">
  <div class="blueprint-instrument__hud">
    <span class="hud-item hud-top-left">
      <span class="hidden sm:inline">FIG 01 // KINEMATIC DRAFTING INSTRUMENT</span>
      <span class="inline sm:hidden">FIG 01 // INSTRUMENT</span>
    </span>
    <span class="hud-item hud-top-right" id="bp-coords">X: 000.0 · Y: 000.0</span>
    <span class="hud-item hud-bottom-left">CALIBRATED // REAL-TIME</span>
    <span class="hud-item hud-bottom-right">INTERACTIVE · DRAG / TAP</span>
  </div>
  <canvas class="blueprint-instrument__canvas" id="blueprint-canvas"></canvas>
</div>

<script>
  function initBlueprint() {
    const canvas = document.getElementById('blueprint-canvas') as HTMLCanvasElement | null;
    const coordsEl = document.getElementById('bp-coords');
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const container = canvas.parentElement;
    if (!container) return;

    let width = 0;
    let height = 0;
    let dpr = 1;
    let isVisible = true;
    let animId = 0;

    // Pointer state
    let mouseX = 0;
    let mouseY = 0;
    let targetX = 0;
    let targetY = 0;
    let isHovered = false;
    let isDragging = false;
    let touchTimeout: number | undefined;
    let time = 0;

    // Pulse ripples on click / tap
    interface Pulse {
      x: number;
      y: number;
      radius: number;
      maxRadius: number;
      alpha: number;
    }
    const pulses: Pulse[] = [];

    // Theme colors extracted from computed styles
    let colFigure = 'rgba(255, 255, 255, 0.85)';
    let colMuted = 'rgba(255, 255, 255, 0.25)';
    let colAccent = '#a3e635';
    let colRule = 'rgba(255, 255, 255, 0.1)';

    function hexToRgba(hexOrCol: string, alpha: number): string {
      const trimmed = hexOrCol.trim();
      if (trimmed.startsWith('rgb')) {
        const matches = trimmed.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/);
        if (matches) {
          return `rgba(${matches[1]}, ${matches[2]}, ${matches[3]}, ${alpha})`;
        }
      }
      const cleanHex = trimmed.replace('#', '');
      let r = 163, g = 230, b = 53;
      if (cleanHex.length === 6) {
        r = parseInt(cleanHex.substring(0, 2), 16);
        g = parseInt(cleanHex.substring(2, 4), 16);
        b = parseInt(cleanHex.substring(4, 6), 16);
      } else if (cleanHex.length === 3) {
        r = parseInt(cleanHex[0] + cleanHex[0], 16);
        g = parseInt(cleanHex[1] + cleanHex[1], 16);
        b = parseInt(cleanHex[2] + cleanHex[2], 16);
      }
      return `rgba(${r}, ${g}, ${b}, ${alpha})`;
    }

    function updateTheme() {
      const style = getComputedStyle(document.documentElement);
      const isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const acc = style.getPropertyValue('--color-accent').trim();

      if (isDark) {
        colFigure = 'rgba(252, 251, 248, 0.9)';
        colMuted = 'rgba(252, 251, 248, 0.35)';
        colRule = 'rgba(252, 251, 248, 0.14)';
      } else {
        colFigure = 'rgba(16, 17, 9, 0.9)';
        colMuted = 'rgba(16, 17, 9, 0.35)';
        colRule = 'rgba(16, 17, 9, 0.12)';
      }
      if (acc) colAccent = acc;
    }

    function resize() {
      if (!container || !canvas) return;
      const rect = container.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      dpr = Math.min(window.devicePixelRatio || 1, 2);

      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);

      if (!isHovered) {
        targetX = width < 640 ? width * 0.5 : width * 0.68;
        targetY = height * 0.5;
        mouseX = targetX;
        mouseY = targetY;
      }
      updateTheme();
      draw();
    }

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function drawStatic() {
      if (!ctx) return;
      updateTheme();
      ctx.save();
      ctx.scale(dpr, dpr);
      ctx.clearRect(0, 0, width, height);

      const cx = width < 640 ? width * 0.5 : width * 0.36;
      const cy = height / 2;

      // Center crosshair
      ctx.strokeStyle = colRule;
      ctx.lineWidth = 1;
      ctx.setLineDash([4, 4]);
      ctx.beginPath();
      ctx.moveTo(0, cy);
      ctx.lineTo(width, cy);
      ctx.moveTo(cx, 0);
      ctx.lineTo(cx, height);
      ctx.stroke();

      // Static rings
      ctx.strokeStyle = colMuted;
      ctx.setLineDash([2, 4]);
      ctx.beginPath();
      ctx.arc(cx, cy, Math.min(width, height) * 0.35, 0, Math.PI * 2);
      ctx.arc(cx, cy, Math.min(width, height) * 0.2, 0, Math.PI * 2);
      ctx.stroke();

      ctx.restore();
    }

    function draw() {
      if (!ctx) return;
      ctx.save();
      ctx.scale(dpr, dpr);
      ctx.clearRect(0, 0, width, height);

      const cx = width < 640 ? width * 0.5 : width * 0.36;
      const cy = height * 0.5;

      // Subtle background grid lines
      ctx.strokeStyle = colRule;
      ctx.lineWidth = 0.75;
      ctx.setLineDash([1, 7]);
      const gridSize = 48;
      ctx.beginPath();
      for (let x = gridSize; x < width; x += gridSize) {
        ctx.moveTo(x, 0);
        ctx.lineTo(x, height);
      }
      for (let y = gridSize; y < height; y += gridSize) {
        ctx.moveTo(0, y);
        ctx.lineTo(width, y);
      }
      ctx.stroke();

      // Major origin crosshair through dial center
      ctx.setLineDash([3, 5]);
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(0, cy);
      ctx.lineTo(width, cy);
      ctx.moveTo(cx, 0);
      ctx.lineTo(cx, height);
      ctx.stroke();
      ctx.setLineDash([]);

      // Rotating mechanical dials around origin
      ctx.save();
      ctx.translate(cx, cy);
      const rot = time * 0.2;
      ctx.rotate(rot);

      const radius1 = Math.min(width, height) * 0.34;
      ctx.strokeStyle = colRule;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.arc(0, 0, radius1, 0, Math.PI * 2);
      ctx.stroke();

      // Outer auxiliary measurement ring
      ctx.strokeStyle = hexToRgba(colMuted, 0.4);
      ctx.setLineDash([2, 4]);
      ctx.beginPath();
      ctx.arc(0, 0, radius1 * 1.18, 0, Math.PI * 2);
      ctx.stroke();
      ctx.setLineDash([]);

      // Radial ticks
      ctx.strokeStyle = colMuted;
      for (let i = 0; i < 24; i++) {
        const angle = (i * Math.PI * 2) / 24;
        const isMajor = i % 6 === 0;
        const tickLen = isMajor ? 8 : 4;
        const x1 = Math.cos(angle) * (radius1 - tickLen);
        const y1 = Math.sin(angle) * (radius1 - tickLen);
        const x2 = Math.cos(angle) * (radius1 + tickLen);
        const y2 = Math.sin(angle) * (radius1 + tickLen);
        ctx.beginPath();
        ctx.moveTo(x1, y1);
        ctx.lineTo(x2, y2);
        ctx.stroke();
      }
      ctx.restore();

      // Satellite orbital nodes
      const numNodes = 3;
      const nodes: { x: number; y: number }[] = [];
      for (let i = 0; i < numNodes; i++) {
        const orbitR = radius1 * (0.65 + i * 0.32);
        const speed = (0.22 / (i + 1)) * (i % 2 === 0 ? 1 : -1);
        const theta = time * speed + (i * Math.PI * 2) / numNodes;
        const nx = cx + Math.cos(theta) * orbitR;
        const ny = cy + Math.sin(theta) * orbitR * 0.85;
        nodes.push({ x: nx, y: ny });

        // Node circle
        ctx.fillStyle = colMuted;
        ctx.beginPath();
        ctx.arc(nx, ny, 2.5, 0, Math.PI * 2);
        ctx.fill();
      }

      // Direct 1:1 tracking when hovered/interacting (eliminates laggy tail), smooth return when idle
      if (isHovered) {
        mouseX = targetX;
        mouseY = targetY;
      } else {
        const lerpSpeed = 0.06;
        mouseX += (targetX - mouseX) * lerpSpeed;
        mouseY += (targetY - mouseY) * lerpSpeed;
      }

      // Update coordinate readout
      if (coordsEl) {
        coordsEl.textContent = `X: ${mouseX.toFixed(1)} · Y: ${mouseY.toFixed(1)}`;
      }

      // Dynamic dimension line from center to cursor
      const dx = mouseX - cx;
      const dy = mouseY - cy;
      const dist = Math.sqrt(dx * dx + dy * dy);
      const angleDeg = ((Math.atan2(dy, dx) * 180) / Math.PI + 360) % 360;

      ctx.strokeStyle = colAccent;
      ctx.lineWidth = 1;
      ctx.setLineDash([4, 4]);
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.lineTo(mouseX, mouseY);
      ctx.stroke();
      ctx.setLineDash([]);

      // Dimension label along line with Plex Mono font
      const midX = (cx + mouseX) / 2;
      const midY = (cy + mouseY) / 2;
      ctx.font = '10px "IBM Plex Mono", monospace';
      ctx.fillStyle = colAccent;
      ctx.fillText(`R: ${dist.toFixed(0)}px  θ: ${angleDeg.toFixed(0)}°`, midX + 8, midY - 6);

      // Connect nodes to mouse if in proximity using active theme accent
      const maxProximity = Math.min(220, Math.max(width, height) * 0.38);
      for (const node of nodes) {
        const ndx = mouseX - node.x;
        const ndy = mouseY - node.y;
        const nDist = Math.sqrt(ndx * ndx + ndy * ndy);
        if (nDist < maxProximity) {
          const alpha = 1 - nDist / maxProximity;
          ctx.strokeStyle = hexToRgba(colAccent, alpha * 0.65);
          ctx.lineWidth = 1;
          ctx.setLineDash([2, 4]);
          ctx.beginPath();
          ctx.moveTo(node.x, node.y);
          ctx.lineTo(mouseX, mouseY);
          ctx.stroke();
          ctx.setLineDash([]);
        }
      }

      // Target Reticle with brackets
      ctx.strokeStyle = colFigure;
      ctx.lineWidth = 1.25;

      const reticleSize = isDragging ? 16 : isHovered ? 13 : 10;
      // Crosshair
      ctx.beginPath();
      ctx.moveTo(mouseX - reticleSize, mouseY);
      ctx.lineTo(mouseX + reticleSize, mouseY);
      ctx.moveTo(mouseX, mouseY - reticleSize);
      ctx.lineTo(mouseX, mouseY + reticleSize);
      ctx.stroke();

      // Corner brackets
      const bLen = 4;
      const bOffset = reticleSize + 3;
      ctx.beginPath();
      // Top-left
      ctx.moveTo(mouseX - bOffset, mouseY - bOffset + bLen);
      ctx.lineTo(mouseX - bOffset, mouseY - bOffset);
      ctx.lineTo(mouseX - bOffset + bLen, mouseY - bOffset);
      // Top-right
      ctx.moveTo(mouseX + bOffset - bLen, mouseY - bOffset);
      ctx.lineTo(mouseX + bOffset, mouseY - bOffset);
      ctx.lineTo(mouseX + bOffset, mouseY - bOffset + bLen);
      // Bottom-left
      ctx.moveTo(mouseX - bOffset, mouseY + bOffset - bLen);
      ctx.lineTo(mouseX - bOffset, mouseY + bOffset);
      ctx.lineTo(mouseX - bOffset + bLen, mouseY + bOffset);
      // Bottom-right
      ctx.moveTo(mouseX + bOffset - bLen, mouseY + bOffset);
      ctx.lineTo(mouseX + bOffset, mouseY + bOffset);
      ctx.lineTo(mouseX + bOffset, mouseY + bOffset - bLen);
      ctx.stroke();

      // Click / Tap Pulses using theme accent (Gold in light mode, Lime in dark mode)
      for (let i = pulses.length - 1; i >= 0; i--) {
        const p = pulses[i];
        p.radius += 3.5;
        p.alpha = Math.max(0, 1 - p.radius / p.maxRadius);

        ctx.strokeStyle = hexToRgba(colAccent, p.alpha * 0.85);
        ctx.lineWidth = 1.25;
        ctx.setLineDash([4, 6]);
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx.stroke();
        ctx.setLineDash([]);

        if (p.radius >= p.maxRadius) {
          pulses.splice(i, 1);
        }
      }

      ctx.restore();
    }

    function loop(timestamp: number) {
      if (!isVisible) return;
      time = timestamp * 0.001;

      // Idle float when not hovered
      if (!isHovered) {
        const orbitCenterX = width < 640 ? width * 0.5 : width * 0.68;
        const orbitCenterY = height * 0.5;
        targetX = orbitCenterX + Math.sin(time * 0.9) * (width * 0.14);
        targetY = orbitCenterY + Math.cos(time * 1.4) * (height * 0.24);
      }

      draw();
      animId = requestAnimationFrame(loop);
    }

    // Pointer and touch interaction
    function getCanvasCoords(e: PointerEvent) {
      if (!container) return { x: 0, y: 0 };
      const rect = container.getBoundingClientRect();
      return {
        x: Math.max(16, Math.min(width - 16, e.clientX - rect.left)),
        y: Math.max(16, Math.min(height - 16, e.clientY - rect.top)),
      };
    }

    container.addEventListener('pointerenter', (e) => {
      if (e.pointerType === 'mouse') {
        clearTimeout(touchTimeout);
        const { x, y } = getCanvasCoords(e);
        targetX = x;
        targetY = y;
        mouseX = x;
        mouseY = y;
        isHovered = true;
      }
    });

    container.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'touch') {
        try {
          container.setPointerCapture(e.pointerId);
        } catch {}
      }
      isDragging = true;
      isHovered = true;
      clearTimeout(touchTimeout);

      const { x, y } = getCanvasCoords(e);
      targetX = x;
      targetY = y;
      mouseX = x;
      mouseY = y;

      pulses.push({
        x,
        y,
        radius: 8,
        maxRadius: Math.max(width, height) * 0.55,
        alpha: 1,
      });
    });

    container.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'mouse' || isDragging) {
        clearTimeout(touchTimeout);
        const { x, y } = getCanvasCoords(e);
        targetX = x;
        targetY = y;
        mouseX = x;
        mouseY = y;
        isHovered = true;
      }
    });

    function handlePointerEnd(e: PointerEvent) {
      if (container && container.hasPointerCapture(e.pointerId)) {
        try {
          container.releasePointerCapture(e.pointerId);
        } catch {}
      }
      isDragging = false;

      if (e.pointerType === 'touch') {
        // Keep hovered for a brief pause before resuming idle Lissajous orbit
        touchTimeout = window.setTimeout(() => {
          isHovered = false;
        }, 1500);
      } else if (container) {
        // For mouse, only exit hover if the cursor is outside container bounds
        const rect = container.getBoundingClientRect();
        const inside =
          e.clientX >= rect.left &&
          e.clientX <= rect.right &&
          e.clientY >= rect.top &&
          e.clientY <= rect.bottom;
        if (!inside) {
          isHovered = false;
        }
      }
    }

    container.addEventListener('pointerup', handlePointerEnd);
    container.addEventListener('pointercancel', handlePointerEnd);
    container.addEventListener('pointerleave', (e) => {
      if (!isDragging && e.pointerType === 'mouse') {
        isHovered = false;
      }
    });

    // Lifecycle: IntersectionObserver
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          isVisible = entry.isIntersecting;
          if (isVisible && !prefersReducedMotion) {
            cancelAnimationFrame(animId);
            animId = requestAnimationFrame(loop);
          } else {
            cancelAnimationFrame(animId);
          }
        });
      },
      { threshold: 0.1 },
    );
    observer.observe(container);

    // Watch for system color-scheme changes
    const darkModeMatcher = window.matchMedia('(prefers-color-scheme: dark)');
    darkModeMatcher.addEventListener('change', () => {
      updateTheme();
      if (prefersReducedMotion) drawStatic();
    });

    window.addEventListener('resize', resize);
    resize();

    if (prefersReducedMotion) {
      drawStatic();
    } else {
      animId = requestAnimationFrame(loop);
    }
  }

  // Run on initial load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBlueprint);
  } else {
    initBlueprint();
  }
</script>

<style>
  .blueprint-instrument {
    position: relative;
    width: 100%;
    height: 320px;
    min-height: 280px;
    background-color: var(--color-ground);
    border: 1px solid var(--color-rule);
    overflow: hidden;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    cursor: none;
  }

  @media (prefers-color-scheme: dark) {
    .blueprint-instrument {
      background-color: var(--color-carbon-950, #0a0a0a);
      border-color: var(--color-carbon-700, #35332e);
    }
  }

  @media (min-width: 640px) {
    .blueprint-instrument {
      height: 400px;
      min-height: 360px;
    }
  }

  @media (min-width: 1024px) {
    .blueprint-instrument {
      height: clamp(420px, 48vh, 560px);
      min-height: 420px;
    }
  }

  .blueprint-instrument__canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .blueprint-instrument__hud {
    position: absolute;
    inset: 0;
    pointer-events: none;
    padding: 0.875rem 1.25rem;
  }

  .hud-item {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-figure);
    opacity: 0.75;
  }

  .hud-top-left {
    top: 0.875rem;
    left: 1.25rem;
  }

  .hud-top-right {
    top: 0.875rem;
    right: 1.25rem;
  }

  .hud-bottom-left {
    bottom: 0.875rem;
    left: 1.25rem;
    color: var(--color-accent);
    opacity: 1;
  }

  .hud-bottom-right {
    bottom: 0.875rem;
    right: 1.25rem;
  }

  @media (max-width: 639px) {
    .hud-top-left {
      top: 0.65rem;
      left: 0.75rem;
    }
    .hud-top-right {
      top: 0.65rem;
      right: 0.75rem;
    }
    .hud-bottom-left {
      bottom: 0.65rem;
      left: 0.75rem;
    }
    .hud-bottom-right {
      bottom: 0.65rem;
      right: 0.75rem;
    }
  }
</style>
