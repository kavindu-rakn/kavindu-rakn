---
import type { CollectionEntry } from 'astro:content';
import TechStack from './TechStack.astro';
import { STATUS_LABEL } from '../consts';

/*
 * One project, as a drawing sheet: index number and status in the header rule,
 * the name set large and blunt, then the verified facts.
 *
 * Every string rendered here comes from the content file. Nothing is computed,
 * summarised or embellished at render time — the guardrails live in the content
 * schema and in `npm run lint:content`, and this component must not route
 * around them.
 */

interface Props {
  entry: CollectionEntry<'work'>;
  /**
   * Sheet number. Comes from the entry's own `order`, never from its position
   * in the grid — a sheet keeps its number for life, the way a drawing does.
   * Positional numbering silently disagreed with the case-study page, which has
   * always printed `order`; the two matched only while no entry was drafted or
   * reordered.
   */
  index?: number;
  /** The technical centrepiece spans the grid and sets larger. */
  feature?: boolean;
}

const { entry, index = entry.data.order, feature = false } = Astro.props;
const d = entry.data;
---

<article
  class:list={[
    'flex min-w-0 flex-col border-2 border-figure bg-ground transition-colors duration-150',
    feature
      ? 'md:col-span-2 bg-ground-raised/30 p-6 sm:p-8 lg:p-10 hover:border-accent'
      : 'p-6 sm:p-8 hover:border-figure/70',
  ]}
>
  <header
    class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2 border-b border-rule pb-3"
  >
    <div class="flex items-center gap-2.5">
      {
        feature && (
          <span class="font-sans text-[10px] font-bold px-2 py-0.5 border border-accent bg-accent/10 text-accent tracking-wider uppercase">
            FLAGSHIP CASE STUDY
          </span>
        )
      }
      <span class="annotation">Sheet {String(index).padStart(2, '0')}</span>
    </div>
    <span class="annotation">{STATUS_LABEL[d.status]}</span>
  </header>

  {
    feature ? (
      <div class="mt-8 grid gap-8 lg:grid-cols-12 lg:items-start">
        <div class="lg:col-span-7 flex flex-col">
          <h3 class="display-title text-4xl sm:text-5xl lg:text-6xl leading-[0.9]">
            {d.title}
          </h3>

          {d.tagline && (
            <p class="mt-4 text-base sm:text-lg text-figure-muted leading-relaxed max-w-xl">
              {d.tagline}
            </p>
          )}

          <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3 pt-2">
            <a
              class="rule-link rule-link--internal rule-link--strong text-sm"
              href={`/work/${entry.id}`}
            >
              Read case study
            </a>

            {d.liveUrl && (
              <a class="rule-link text-sm" href={d.liveUrl} rel="noopener noreferrer" target="_blank">
                Live site
              </a>
            )}

            {d.githubUrl && (
              <a class="rule-link text-sm" href={d.githubUrl} rel="noopener noreferrer" target="_blank">
                Source
              </a>
            )}

            {d.sourcePrivate && (
              <span class="annotation text-xs">Source private · on request</span>
            )}

            {d.employment && !d.githubUrl && !d.liveUrl && (
              <span class="annotation text-xs">Internal platform</span>
            )}
          </div>
        </div>

        <div class="lg:col-span-5 flex flex-col border-t border-rule pt-6 lg:border-t-0 lg:border-l lg:border-rule lg:pl-8 lg:pt-0">
          <p class="annotation text-figure font-mono text-xs uppercase tracking-wider pb-2 border-b border-rule">
            Key Highlights
          </p>

          {d.highlights && (
            <ul class="mt-4 space-y-2.5">
              {d.highlights.map((point) => (
                <li class="flex gap-3 text-sm leading-relaxed">
                  <span class="mt-[0.6em] h-px w-3 shrink-0 bg-accent" aria-hidden="true" />
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          )}

          <div class="mt-6 border-t border-rule/60 pt-4">
            <TechStack items={d.techStack} />
          </div>
        </div>
      </div>
    ) : (
      <div class="flex flex-1 flex-col">
        <h3 class="display-title mt-6 text-3xl sm:text-4xl leading-[0.88]">
          {d.title}
        </h3>

        {d.tagline && (
          <p class="mt-4 text-base text-figure-muted">
            {d.tagline}
          </p>
        )}

        {d.highlights && (
          <ul class="mt-6 space-y-2.5">
            {d.highlights.map((point) => (
              <li class="flex gap-3 text-sm leading-relaxed">
                <span class="mt-[0.6em] h-px w-3 shrink-0 bg-accent" aria-hidden="true" />
                <span>{point}</span>
              </li>
            ))}
          </ul>
        )}

        <div class="mt-auto pt-6">
          <TechStack items={d.techStack} />
        </div>

        <footer class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3 border-t border-rule pt-4">
          <a class="rule-link rule-link--internal rule-link--strong" href={`/work/${entry.id}`}>
            Case study
          </a>

          {d.liveUrl && (
            <a class="rule-link" href={d.liveUrl} rel="noopener noreferrer" target="_blank">
              Live site
            </a>
          )}

          {d.githubUrl && (
            <a class="rule-link" href={d.githubUrl} rel="noopener noreferrer" target="_blank">
              Source
            </a>
          )}

          {d.sourcePrivate && <span class="annotation">Source private · on request</span>}

          {d.employment && !d.githubUrl && !d.liveUrl && (
            <span class="annotation">Internal platform</span>
          )}
        </footer>
      </div>
    )
  }
</article>

