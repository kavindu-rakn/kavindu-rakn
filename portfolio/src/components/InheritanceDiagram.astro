---
import { CATALOGUE, EDGES, categoryById, resolveSchema, impactOf } from '../data/catalogue-demo';

/*
 * The inheritance tree, made operable.
 *
 * BRIEF §3.1: "the inheritance tree is inherently diagrammable. An interactive
 * diagram showing a field defined on Electronics flowing down into Laptops and
 * Smartphones, and the impact panel lighting up as a change is typed, would be
 * the best single visual on the site."
 *
 * Server-rendered complete: the tree, and Electronics' resolved schema, are in
 * the HTML. With JavaScript off you get a finished diagram rather than an empty
 * frame — the same principle as the hero's static blueprint. The island only
 * adds selection and the live impact readout, and the controls stay hidden
 * until it boots so no dead inputs are ever shown.
 */

const DEFAULT_ID = 'electronics';
const initial = categoryById(DEFAULT_ID)!;
const initialSchema = resolveSchema(DEFAULT_ID);
const initialImpact = impactOf(DEFAULT_ID);

const X = (gx: number) => 190 + gx * 90;
const Y = (gy: number) => 34 + -gy * 106;
const NODE_W = 150;
const NODE_H = 36;

const edgePaths = EDGES.map(([parentId, childId]) => {
  const p = categoryById(parentId)!;
  const c = categoryById(childId)!;
  const y0 = Y(p.gy) + NODE_H / 2;
  const y1 = Y(c.gy) - NODE_H / 2;
  const bus = (y0 + y1) / 2;
  return `M ${X(p.gx)} ${y0} V ${bus} H ${X(c.gx)} V ${y1}`;
});
---

<figure class="diagram" data-diagram data-selected={DEFAULT_ID}>
  <figcaption class="diagram__caption">
    <span class="annotation">Worked example · illustrative fixture data</span>
  </figcaption>

  <div class="diagram__body">
    <svg
      class="diagram__tree"
      viewBox="0 0 380 300"
      role="img"
      aria-label="Category tree. Electronics inherits downward into Laptops and Smartphones; Laptops inherits downward into Gaming laptops."
      data-tree
    >
      <g class="tree-edge">{edgePaths.map((d) => <path d={d} />)}</g>

      {
        CATALOGUE.map((node) => (
          <g
            class="tree-node"
            data-category={node.id}
            data-state={node.id === DEFAULT_ID ? 'selected' : 'idle'}
          >
            <rect
              x={X(node.gx) - NODE_W / 2}
              y={Y(node.gy) - NODE_H / 2}
              width={NODE_W}
              height={NODE_H}
            />
            <text x={X(node.gx)} y={Y(node.gy) + 4}>
              {node.label}
            </text>
          </g>
        ))
      }
    </svg>

    <div class="diagram__panel">
      <p class="annotation diagram__panel-head">
        Resolved schema · <span data-selected-label>{initial.label}</span>
      </p>

      <ul class="fields" data-fields>
        {
          initialSchema.map(({ field, origin, inherited }) => (
            <li class="field" data-inherited={String(inherited)}>
              <code class="field__key">{field.key}</code>
              <span class="field__type">{field.type}</span>
              <span class="field__origin">
                {inherited ? `inherited · ${origin.label}` : 'declared here'}
              </span>
            </li>
          ))
        }
      </ul>

      <p class="diagram__rule annotation">
        Inherited fields may be relabelled here. They may not be deleted or
        retyped — those are the two operations that invalidate data an ancestor
        owns.
      </p>

      <div class="controls" data-controls hidden>
        <label class="annotation" for="new-field">
          Declare a field on <span data-selected-label>{initial.label}</span>
        </label>
        <input
          class="controls__input"
          id="new-field"
          type="text"
          autocomplete="off"
          spellcheck="false"
          placeholder="energy_rating"
          data-field-input
        />
        <p class="controls__impact" data-impact aria-live="polite">
          <span class="controls__impact-idle"
            >Type a field name to see the blast radius.</span
          >
        </p>
      </div>

      <p class="controls__static annotation" data-static-note>
        Applying this change would affect {initialImpact.categories} categories and
        {initialImpact.items.toLocaleString('en-GB')} items.
      </p>
    </div>
  </div>
</figure>

<style>
  .diagram {
    margin: 3rem 0;
    border: 2px solid var(--color-figure);
  }

  .diagram__caption {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-rule);
  }

  .diagram__body {
    display: grid;
    gap: 1.5rem;
    padding: 1.5rem 1rem;
  }

  @media (min-width: 52rem) {
    .diagram__body {
      grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
      align-items: start;
      padding: 1.75rem;
    }
  }

  .diagram__tree {
    width: 100%;
    height: auto;
  }

  .tree-edge path {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.25;
    opacity: 0.7;
  }

  .tree-node rect {
    fill: var(--color-ground);
    stroke: var(--color-accent);
    stroke-width: 1.25;
    transition: fill 160ms ease, stroke-width 160ms ease;
  }

  .tree-node text {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-anchor: middle;
    text-transform: uppercase;
    fill: var(--color-figure);
  }

  .tree-node[data-state='selected'] rect {
    fill: var(--color-accent);
    stroke-width: 2;
  }
  .tree-node[data-state='selected'] text {
    fill: var(--color-ground);
  }

  /* Everything the pending change would reach. */
  .tree-node[data-state='impacted'] rect {
    fill: var(--color-signal-500);
    stroke: #0a0a0a;
    stroke-width: 2;
  }
  .tree-node[data-state='impacted'] text {
    fill: #0a0a0a;
  }

  [data-enhanced] .tree-node {
    cursor: pointer;
  }
  /*
   * Focus is drawn with `stroke`, not `outline`. An outline on an SVG shape is
   * not reliably painted — WebKit in particular ignores it — so the keyboard
   * indicator existed on paper and not on screen. The outline is kept as well,
   * for engines that do honour it.
   */
  [data-enhanced] .tree-node:focus-visible rect {
    stroke: var(--color-accent);
    stroke-width: 3;
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .diagram__panel-head {
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--color-rule);
  }

  .fields {
    margin-top: 0.9rem;
    list-style: none;
    padding: 0;
  }

  .field {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.85rem;
    padding: 0.45rem 0;
    padding-left: 0.75rem;
    border-left: 2px solid var(--color-rule);
  }

  .field[data-inherited='false'] {
    border-left-color: var(--color-accent);
  }

  /* A field the pending change would add. */
  .field[data-pending='true'] {
    border-left-color: var(--color-signal-500);
  }

  .field__key {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-figure);
  }

  .field__type,
  .field__origin {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-figure-muted);
  }

  .field__origin {
    margin-left: auto;
  }

  .diagram__rule {
    margin-top: 1rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--color-rule);
    text-transform: none;
    letter-spacing: 0.02em;
    line-height: 1.6;
  }

  .controls {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-rule);
  }

  .controls__input {
    display: block;
    width: 100%;
    margin-top: 0.6rem;
    padding: 0.55rem 0.7rem;
    background-color: var(--color-ground);
    border: 2px solid var(--color-rule);
    color: var(--color-figure);
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  /*
   * A 2px border-colour change is not a focus indicator: it is the same weight
   * as the resting border and disappears against several backgrounds. This is
   * the only text input on the site, and it had `outline: none` at a
   * specificity that beat the global :focus-visible rule.
   */
  .controls__input:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-color: var(--color-accent);
  }

  .controls__impact {
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--color-figure-muted);
  }

  .controls__impact[data-live='true'] {
    color: var(--color-figure);
  }

  .controls__static {
    margin-top: 1rem;
    text-transform: none;
    letter-spacing: 0.02em;
  }

  /* The static summary is only the no-JS story; the live readout replaces it. */
  [data-enhanced] .controls__static {
    display: none;
  }
</style>

<script>
  import {
    CATALOGUE,
    categoryById,
    resolveSchema,
    impactOf,
  } from '../data/catalogue-demo';

  const rootEl = document.querySelector<HTMLElement>('[data-diagram]');
  const treeEl = rootEl?.querySelector<SVGElement>('[data-tree]');
  const fieldsEl = rootEl?.querySelector<HTMLElement>('[data-fields]');
  const controlsEl = rootEl?.querySelector<HTMLElement>('[data-controls]');
  const inputEl = rootEl?.querySelector<HTMLInputElement>('[data-field-input]');
  const impactEl = rootEl?.querySelector<HTMLElement>('[data-impact]');

  if (rootEl && treeEl && fieldsEl && controlsEl && inputEl && impactEl) {
    /*
     * Re-bound as consts inside the guard. The functions below outlive the
     * `if`, so TypeScript widens the outer bindings back to nullable when they
     * are captured; these aliases stay narrowed.
     */
    const root = rootEl;
    const tree = treeEl;
    const fields = fieldsEl;
    const controls = controlsEl;
    const input = inputEl;
    const impactOut = impactEl;

    let selected = root.dataset.selected ?? 'electronics';

    /*
     * The SVG ships as role="img" with a label, which is correct while it is a
     * picture. Once these nodes become buttons it stops being one: role="img"
     * makes its entire subtree presentational, so the controls below were
     * focusable but never announced. Enhancing it turns it into a group.
     */
    tree.setAttribute('role', 'group');

    const nodes = new Map<string, SVGGElement>();
    for (const g of tree.querySelectorAll<SVGGElement>('[data-category]')) {
      const id = g.dataset.category;
      if (!id) continue;
      nodes.set(id, g);
      // Only advertise controls once they actually work.
      g.setAttribute('role', 'button');
      g.setAttribute('tabindex', '0');
      g.setAttribute('aria-label', `Select ${categoryById(id)?.label ?? id}`);
    }

    const escapeHtml = (s: string) =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

    /** A plausible attribute key, so the readout does not react to noise. */
    const normalise = (raw: string) =>
      raw
        .trim()
        .toLowerCase()
        .replace(/[^a-z0-9_]+/g, '_')
        .replace(/^_+|_+$/g, '');

    function renderFields(pending: string) {
      const resolved = resolveSchema(selected);
      const rows = resolved.map(
        ({ field, origin, inherited }) => `
          <li class="field" data-inherited="${inherited}">
            <code class="field__key">${escapeHtml(field.key)}</code>
            <span class="field__type">${field.type}</span>
            <span class="field__origin">${
              inherited ? `inherited · ${escapeHtml(origin.label)}` : 'declared here'
            }</span>
          </li>`,
      );

      if (pending) {
        rows.push(`
          <li class="field" data-inherited="false" data-pending="true">
            <code class="field__key">${escapeHtml(pending)}</code>
            <span class="field__type">pending</span>
            <span class="field__origin">would be declared here</span>
          </li>`);
      }

      fields.innerHTML = rows.join('');
    }

    function renderImpact(pending: string) {
      const { categories, items, ids } = impactOf(selected);

      for (const [id, g] of nodes) {
        const state =
          pending && ids.includes(id)
            ? 'impacted'
            : id === selected
              ? 'selected'
              : 'idle';
        g.dataset.state = state;
      }

      if (!pending) {
        impactOut.dataset.live = 'false';
        impactOut.textContent = 'Type a field name to see the blast radius.';
        return;
      }

      impactOut.dataset.live = 'true';
      const label = categoryById(selected)?.label ?? selected;
      impactOut.textContent =
        `Declaring "${pending}" on ${label} composes down into ` +
        `${categories} ${categories === 1 ? 'category' : 'categories'} and ` +
        `${items.toLocaleString('en-GB')} items. Nothing is written until it is applied.`;
    }

    function update() {
      const pending = normalise(input.value);
      const label = categoryById(selected)?.label ?? selected;
      for (const el of root.querySelectorAll('[data-selected-label]')) {
        el.textContent = label;
      }
      renderFields(pending);
      renderImpact(pending);
    }

    function select(id: string) {
      if (!categoryById(id) || id === selected) return;
      selected = id;
      root.dataset.selected = id;
      update();
    }

    for (const [id, g] of nodes) {
      g.addEventListener('click', () => select(id));
      g.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          select(id);
        }
      });
    }

    input.addEventListener('input', update);

    controls.hidden = false;
    root.dataset.enhanced = 'true';
    update();

    // Referenced so the import is not shaken out; also a cheap sanity check.
    if (CATALOGUE.length === 0) controls.hidden = true;
  }
</script>
