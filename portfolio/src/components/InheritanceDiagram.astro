---
import { CATALOGUE, EDGES, categoryById, resolveSchema, impactOf } from '../data/catalogue-demo';

/*
 * The inheritance tree, made operable.
 *
 * An inheritance tree is inherently diagrammable. A field defined on
 * Electronics flowing down into Laptops and Smartphones, with the impact panel
 * lighting up as a change is typed, explains the product faster than the prose
 * around it can.
 *
 * Server-rendered complete: the tree, and Electronics' resolved schema, are in
 * the HTML. With JavaScript off you get a finished diagram rather than an empty
 * frame. The island adds interactive node selection and the live impact readout.
 */

const DEFAULT_ID = 'electronics';
const initial = categoryById(DEFAULT_ID)!;
const initialSchema = resolveSchema(DEFAULT_ID);
const initialImpact = impactOf(DEFAULT_ID);

/*
 * Vector coordinates for the schematic tree:
 * Electronics (root) sits top-center.
 * Laptops and Smartphones branch out symmetrically.
 * Gaming laptops extends downward from Laptops.
 */
const X = (id: string) => {
  switch (id) {
    case 'electronics': return 210;
    case 'laptops': return 105;
    case 'smartphones': return 315;
    case 'gaming-laptops': return 105;
    default: return 210;
  }
};

const Y = (id: string) => {
  switch (id) {
    case 'electronics': return 46;
    case 'laptops': return 160;
    case 'smartphones': return 160;
    case 'gaming-laptops': return 270;
    default: return 46;
  }
};

const NODE_W = (id: string) => (id === 'electronics' ? 168 : 148);
const NODE_H = 50;

const edgePaths = EDGES.map(([parentId, childId]) => {
  const px = X(parentId);
  const py = Y(parentId) + NODE_H / 2;
  const cx = X(childId);
  const cy = Y(childId) - NODE_H / 2 - 3;
  if (px === cx) {
    return { id: `${parentId}-${childId}`, d: `M ${px} ${py} V ${cy}` };
  }
  const bus = py + 30;
  return { id: `${parentId}-${childId}`, d: `M ${px} ${py} V ${bus} H ${cx} V ${cy}` };
});
---

<figure class="diagram" data-diagram data-selected={DEFAULT_ID}>
  <figcaption class="diagram__caption flex items-center justify-between">
    <span class="annotation">Worked example · Schema inheritance engine</span>
    <span class="annotation text-accent font-mono text-[10px]">SVG // VECTOR SCHEMATIC</span>
  </figcaption>

  <div class="diagram__body">
    <div class="diagram__tree-wrap">
      <svg
        class="diagram__tree"
        viewBox="0 0 420 320"
        role="img"
        aria-label="Category tree. Electronics inherits downward into Laptops and Smartphones; Laptops inherits downward into Gaming laptops."
        data-tree
      >
        <defs>
          <marker
            id="tree-arrow"
            viewBox="0 0 8 8"
            refX="4"
            refY="4"
            markerWidth="5"
            markerHeight="5"
            orient="auto-start-reverse"
          >
            <path d="M 0 1.5 L 6.5 4 L 0 6.5 z" fill="var(--color-accent)" />
          </marker>
        </defs>

        <g class="tree-edge">
          {edgePaths.map(({ d, id }) => (
            <path d={d} data-edge={id} marker-end="url(#tree-arrow)" />
          ))}
        </g>

        {
          CATALOGUE.map((node) => {
            const w = NODE_W(node.id);
            const h = NODE_H;
            const left = X(node.id) - w / 2;
            const top = Y(node.id) - h / 2;
            return (
              <g
                class="tree-node"
                data-category={node.id}
                data-state={node.id === DEFAULT_ID ? 'selected' : 'idle'}
              >
                <rect
                  class="tree-node__bg"
                  x={left}
                  y={top}
                  width={w}
                  height={h}
                  rx="6"
                />
                <circle
                  class="tree-node__dot"
                  cx={left + 16}
                  cy={top + h / 2}
                  r="3.5"
                />
                <text class="tree-node__title" x={left + 28} y={top + 21}>
                  {node.label}
                </text>
                <text class="tree-node__meta" x={left + 28} y={top + 36}>
                  {node.declares.length} {node.declares.length === 1 ? 'decl' : 'decls'} · {node.items > 0 ? `${node.items} items` : 'root model'}
                </text>
              </g>
            );
          })
        }
      </svg>
      <p class="mt-2 text-center text-[10px] font-mono text-figure-muted opacity-60">
        Click any category node to inspect its inheritance composition
      </p>
    </div>

    <div class="diagram__panel">
      <div class="diagram__panel-head flex items-center justify-between pb-3">
        <span class="annotation">Resolved Schema</span>
        <span class="schema-badge font-sans text-xs font-semibold px-2.5 py-0.5 border border-accent bg-accent/10 text-accent tracking-wide uppercase" data-selected-label>
          {initial.label}
        </span>
      </div>

      <ul class="fields" data-fields>
        {
          initialSchema.map(({ field, origin, inherited }) => (
            <li class="field" data-inherited={String(inherited)}>
              <div class="field__decl">
                <code class="field__key">{field.key}</code>
                <span class="field__colon">:</span>
                <span class="field__type">{field.type}</span>
              </div>
              <span class="field__origin">
                {inherited ? `inherited · ${origin.label}` : 'declared here'}
              </span>
            </li>
          ))
        }
      </ul>

      <p class="diagram__rule annotation">
        Inherited fields may be relabelled locally. They cannot be deleted or
        retyped without breaking ancestor contracts.
      </p>

      <div class="controls" data-controls hidden>
        <label class="annotation flex items-center justify-between" for="new-field">
          <span>Test Schema Mutation</span>
          <span class="text-accent">// Live Preview</span>
        </label>
        <div class="controls__input-wrap">
          <span class="controls__input-prefix font-mono">+</span>
          <input
            class="controls__input"
            id="new-field"
            type="text"
            autocomplete="off"
            spellcheck="false"
            placeholder="e.g. energy_rating"
            data-field-input
          />
        </div>
        <div class="controls__impact-box mt-3" data-impact-box>
          <p class="controls__impact" data-impact aria-live="polite">
            <span class="controls__impact-idle"
              >Type a field name to calculate downstream blast radius.</span
            >
          </p>
        </div>
      </div>

      <p class="controls__static annotation" data-static-note>
        Applying this change would affect {initialImpact.categories} categories and
        {initialImpact.items.toLocaleString('en-GB')} items.
      </p>
    </div>
  </div>
</figure>

<style>
  .diagram {
    margin: 3rem 0;
    border: 2px solid var(--color-figure);
    background-color: var(--color-ground);
  }

  .diagram__caption {
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid var(--color-rule);
    background-color: var(--color-ground-raised);
  }

  .diagram__body {
    display: grid;
    gap: 1.5rem;
    padding: 1.5rem;
  }

  @media (min-width: 52rem) {
    .diagram__body {
      grid-template-columns: minmax(0, 24rem) minmax(0, 1fr);
      align-items: start;
      padding: 2rem;
    }
  }

  .diagram__tree-wrap {
    display: flex;
    flex-direction: column;
  }

  .diagram__tree {
    width: 100%;
    height: auto;
  }

  .tree-edge path {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.5;
    stroke-dasharray: 4 3;
    opacity: 0.8;
    transition: all 200ms ease;
  }

  .tree-node {
    user-select: none;
  }

  .tree-node .tree-node__bg {
    fill: var(--color-ground-raised);
    stroke: var(--color-rule);
    stroke-width: 1.25;
    transition: all 180ms ease;
  }

  .tree-node .tree-node__dot {
    fill: var(--color-figure-muted);
    opacity: 0.4;
    transition: all 180ms ease;
  }

  .tree-node .tree-node__title {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: -0.01em;
    fill: var(--color-figure);
    transition: fill 180ms ease;
  }

  .tree-node .tree-node__meta {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 400;
    letter-spacing: 0.02em;
    fill: var(--color-figure-muted);
    transition: fill 180ms ease;
  }

  /* Selected state */
  .tree-node[data-state='selected'] .tree-node__bg {
    stroke: var(--color-accent);
    stroke-width: 2;
    fill: var(--color-ground-raised);
  }

  .tree-node[data-state='selected'] .tree-node__dot {
    fill: var(--color-accent);
    opacity: 1;
  }

  .tree-node[data-state='selected'] .tree-node__title {
    fill: var(--color-accent);
  }

  /* Impacted state */
  .tree-node[data-state='impacted'] .tree-node__bg {
    stroke: var(--color-signal-500, #f59e0b);
    stroke-width: 2;
    fill: var(--color-ground-raised);
  }

  .tree-node[data-state='impacted'] .tree-node__dot {
    fill: var(--color-signal-500, #f59e0b);
    opacity: 1;
  }

  .tree-node[data-state='impacted'] .tree-node__title,
  .tree-node[data-state='impacted'] .tree-node__meta {
    fill: var(--color-signal-500, #f59e0b);
  }

  [data-enhanced] .tree-node {
    cursor: pointer;
  }

  [data-enhanced] .tree-node:hover .tree-node__bg {
    border-color: var(--color-figure);
    stroke: var(--color-figure);
  }

  [data-enhanced] .tree-node:focus-visible .tree-node__bg {
    stroke: var(--color-accent);
    stroke-width: 2.5;
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .diagram__panel {
    border: 1px solid var(--color-rule);
    background-color: var(--color-ground-raised);
    padding: 1.25rem 1.5rem;
  }

  .diagram__panel-head {
    border-bottom: 1px solid var(--color-rule);
  }

  .fields {
    margin-top: 1rem;
    list-style: none;
    padding: 0;
  }

  .field {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.45rem 0.75rem;
    background: var(--color-ground);
    border: 1px solid var(--color-rule);
    margin-bottom: 0.4rem;
    border-left: 3px solid var(--color-rule);
    transition: border-color 150ms ease;
  }

  .field[data-inherited='false'] {
    border-left-color: var(--color-accent);
  }

  .field[data-pending='true'] {
    border-left-color: var(--color-signal-500, #f59e0b);
    background-color: var(--color-ground-raised);
  }

  .field__decl {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
  }

  .field__key {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-figure);
  }

  .field__colon {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-figure-muted);
  }

  .field__type {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-accent);
  }

  .field__origin {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-figure-muted);
  }

  .diagram__rule {
    margin-top: 1rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--color-rule);
    text-transform: none;
    letter-spacing: 0.02em;
    line-height: 1.6;
  }

  .controls {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-rule);
  }

  .controls__input-wrap {
    display: flex;
    align-items: center;
    margin-top: 0.6rem;
    border: 1px solid var(--color-rule);
    background-color: var(--color-ground);
    transition: border-color 150ms ease;
  }

  .controls__input-wrap:focus-within {
    border-color: var(--color-accent);
    outline: 1px solid var(--color-accent);
  }

  .controls__input-prefix {
    padding-left: 0.75rem;
    color: var(--color-accent);
    font-size: 0.875rem;
  }

  .controls__input {
    display: block;
    width: 100%;
    padding: 0.55rem 0.75rem;
    background: transparent;
    border: none;
    outline: none;
    color: var(--color-figure);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .controls__impact-box {
    border: 1px dashed var(--color-rule);
    padding: 0.65rem 0.85rem;
    background-color: var(--color-ground);
  }

  .controls__impact {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--color-figure-muted);
  }

  .controls__impact[data-live='true'] {
    color: var(--color-figure);
  }

  .controls__static {
    margin-top: 1rem;
    text-transform: none;
    letter-spacing: 0.02em;
  }

  [data-enhanced] .controls__static {
    display: none;
  }
</style>

<script>
  import {
    CATALOGUE,
    categoryById,
    resolveSchema,
    impactOf,
  } from '../data/catalogue-demo';

  const rootEl = document.querySelector<HTMLElement>('[data-diagram]');
  const treeEl = rootEl?.querySelector<SVGElement>('[data-tree]');
  const fieldsEl = rootEl?.querySelector<HTMLElement>('[data-fields]');
  const controlsEl = rootEl?.querySelector<HTMLElement>('[data-controls]');
  const inputEl = rootEl?.querySelector<HTMLInputElement>('[data-field-input]');
  const impactEl = rootEl?.querySelector<HTMLElement>('[data-impact]');

  if (rootEl && treeEl && fieldsEl && controlsEl && inputEl && impactEl) {
    const root = rootEl;
    const tree = treeEl;
    const fields = fieldsEl;
    const controls = controlsEl;
    const input = inputEl;
    const impactOut = impactEl;

    let selected = root.dataset.selected ?? 'electronics';

    tree.setAttribute('role', 'group');

    const nodes = new Map<string, SVGGElement>();
    for (const g of tree.querySelectorAll<SVGGElement>('[data-category]')) {
      const id = g.dataset.category;
      if (!id) continue;
      nodes.set(id, g);
      g.setAttribute('role', 'button');
      g.setAttribute('tabindex', '0');
      g.setAttribute('aria-label', `Select ${categoryById(id)?.label ?? id}`);
    }

    const escapeHtml = (s: string) =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

    const normalise = (raw: string) =>
      raw
        .trim()
        .toLowerCase()
        .replace(/[^a-z0-9_]+/g, '_')
        .replace(/^_+|_+$/g, '');

    function renderFields(pending: string) {
      const resolved = resolveSchema(selected);
      const rows = resolved.map(
        ({ field, origin, inherited }) => `
          <li class="field" data-inherited="${inherited}">
            <div class="field__decl">
              <code class="field__key">${escapeHtml(field.key)}</code>
              <span class="field__colon">:</span>
              <span class="field__type">${field.type}</span>
            </div>
            <span class="field__origin">${
              inherited ? `inherited · ${escapeHtml(origin.label)}` : 'declared here'
            }</span>
          </li>`,
      );

      if (pending) {
        rows.push(`
          <li class="field field--pending" data-inherited="false" data-pending="true">
            <div class="field__decl">
              <code class="field__key">${escapeHtml(pending)}</code>
              <span class="field__colon">:</span>
              <span class="field__type">pending</span>
            </div>
            <span class="field__origin">would be declared here</span>
          </li>`);
      }

      fields.innerHTML = rows.join('');
    }

    function renderImpact(pending: string) {
      const { categories, items, ids } = impactOf(selected);

      for (const [id, g] of nodes) {
        const state =
          pending && ids.includes(id)
            ? 'impacted'
            : id === selected
              ? 'selected'
              : 'idle';
        g.dataset.state = state;
      }

      if (!pending) {
        impactOut.dataset.live = 'false';
        impactOut.textContent = 'Type a field name to calculate downstream blast radius.';
        return;
      }

      impactOut.dataset.live = 'true';
      const label = categoryById(selected)?.label ?? selected;
      impactOut.textContent =
        `Declaring "${pending}" on ${label} composes down into ` +
        `${categories} ${categories === 1 ? 'category' : 'categories'} and ` +
        `${items.toLocaleString('en-GB')} items. Nothing is written until it is applied.`;
    }

    function update() {
      const pending = normalise(input.value);
      const label = categoryById(selected)?.label ?? selected;
      for (const el of root.querySelectorAll('[data-selected-label]')) {
        el.textContent = label;
      }
      renderFields(pending);
      renderImpact(pending);
    }

    function select(id: string) {
      if (!categoryById(id) || id === selected) return;
      selected = id;
      root.dataset.selected = id;
      update();
    }

    for (const [id, g] of nodes) {
      g.addEventListener('click', () => select(id));
      g.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          select(id);
        }
      });
    }

    input.addEventListener('input', update);

    controls.hidden = false;
    root.dataset.enhanced = 'true';
    update();

    if (CATALOGUE.length === 0) controls.hidden = true;
  }
</script>
