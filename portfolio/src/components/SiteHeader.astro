---
import RGlyph from '../assets/wordmark-r.svg';
import { SITE, NAV } from '../consts';

interface Props {
  /** The nav href matching this exact page. Gets `aria-current="page"`. */
  current?: string;
  /**
   * The nav href this page sits *under* rather than *is* — a case study lives
   * under Work but is not the Work anchor. It gets the active styling and
   * `aria-current="true"`, because claiming `page` on a page that is not that
   * page tells a screen reader something false.
   */
  within?: string;
}
const { current, within } = Astro.props;

const pageLinks = NAV.filter((item) => !item.file);
const resumeItem = NAV.find((item) => item.file);
---

<header class="sticky top-0 z-50 border-b border-rule bg-ground">
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between gap-x-3 px-4 py-3.5 sm:px-6"
    aria-label="Primary"
  >
    <a href="/" class="brand" aria-label={SITE.name}>
      <span class="brand__mark" aria-hidden="true"><RGlyph /></span>
      <span class="annotation hidden min-[540px]:inline" aria-hidden="true">{SITE.name}</span>
      <span class="annotation inline min-[540px]:hidden" aria-hidden="true">K. Ranathunga</span>
    </a>

    <div class="flex items-center gap-x-3 sm:gap-x-6 lg:gap-x-8">
      <ul class="flex items-center gap-x-2.5 min-[380px]:gap-x-3.5 sm:gap-x-5 lg:gap-x-6" role="list">
        {
          pageLinks.map((item) => {
            const sectionId = item.href.includes('#') ? item.href.split('#')[1] : undefined;
            const isAboutPage = item.href === '/about' && current === '/about';
            const isWorkSubPage = item.href.includes('work') && within === '/#work';

            return (
              <li>
                <a
                  href={item.href}
                  class="annotation nav-link"
                  data-section={sectionId}
                  aria-current={current === item.href ? 'page' : isWorkSubPage ? 'true' : undefined}
                  data-active={isAboutPage || isWorkSubPage ? 'true' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>

      {
        resumeItem && (
          <a
            href={resumeItem.href}
            target="_blank"
            rel="noopener noreferrer"
            class="nav-resume group"
            aria-label="Resume (PDF)"
          >
            <span>{resumeItem.label}</span>
            <svg
              class="h-2.5 w-2.5 transition-transform duration-150 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
              viewBox="0 0 12 12"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              aria-hidden="true"
            >
              <path d="M2.5 9.5L9.5 2.5M9.5 2.5H4.5M9.5 2.5V7.5" />
            </svg>
          </a>
        )
      }
    </div>
  </nav>
</header>

<script>
  function initNavScrollspy() {
    const hasHomeSections = document.getElementById('index') && document.getElementById('work');
    if (!hasHomeSections) return;

    const sectionIds = ['index', 'work', 'tech', 'contact'];
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('nav a[data-section]');

    let ticking = false;

    function updateActive() {
      const scrollPos = window.scrollY + 140;
      let activeId = 'index';

      // Check if scrolled near bottom of page
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 60) {
        activeId = 'contact';
      } else {
        for (const id of sectionIds) {
          const el = document.getElementById(id);
          if (el && scrollPos >= el.offsetTop) {
            activeId = id;
          }
        }
      }

      navLinks.forEach((link) => {
        const sec = link.getAttribute('data-section');
        if (sec === activeId) {
          link.setAttribute('data-active', 'true');
        } else {
          link.removeAttribute('data-active');
        }
      });
    }

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          updateActive();
          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    updateActive();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNavScrollspy);
  } else {
    initNavScrollspy();
  }
  document.addEventListener('astro:page-load', initNavScrollspy);
</script>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    white-space: nowrap;
    min-height: 44px;
    margin-block: -0.5rem;
    padding-block: 0.5rem;
  }

  .brand:hover .annotation {
    color: var(--color-figure);
  }

  .brand__mark :global(svg) {
    display: block;
    height: 1.1rem;
    width: auto;
  }

  /*
   * Navlinks with dynamic left-to-right underline drawing
   */
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-block: -0.5rem;
    padding-block: 0.5rem;
    color: var(--color-figure-muted);
    text-decoration: none !important;
    transition: color 0.15s ease;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0.55rem;
    left: 0;
    right: 0;
    height: 2px;
    background-color: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.18s ease;
    opacity: 0;
    pointer-events: none;
  }

  /*
   * Active indicator styling
   */
  .nav-link[data-active='true'] {
    color: var(--color-figure);
  }

  .nav-link[data-active='true']::after {
    transform: scaleX(1);
    opacity: 1;
  }

  .nav-link:hover {
    color: var(--color-figure);
  }

  /*
   * Distinctly styled Resume button at the far right corner
   */
  .nav-resume {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.28rem 0.65rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem; /* 11px */
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-figure);
    border: 1px solid var(--color-figure);
    background-color: transparent;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    white-space: nowrap;
  }

  .nav-resume:hover {
    background-color: var(--color-figure);
    color: var(--color-ground);
  }
</style>
