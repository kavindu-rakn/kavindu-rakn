---
import RGlyph from '../assets/wordmark-r.svg';
import { SITE, NAV } from '../consts';

interface Props {
  /** The nav href matching this exact page. Gets `aria-current="page"`. */
  current?: string;
  /**
   * The nav href this page sits *under* rather than *is* — a case study lives
   * under Work but is not the Work anchor. It gets the active styling and
   * `aria-current="true"`, because claiming `page` on a page that is not that
   * page tells a screen reader something false.
   */
  within?: string;
}
const { current, within } = Astro.props;
---

<header class="sticky top-0 z-50 border-b border-rule bg-ground">
  <nav
    class="mx-auto flex max-w-6xl flex-wrap items-baseline justify-between gap-x-6 gap-y-2 px-6 py-4"
    aria-label="Primary"
  >
    <a href="/" class="brand" aria-label={SITE.name}>
      <span class="brand__mark" aria-hidden="true"><RGlyph /></span>
      <span class="annotation" aria-hidden="true">{SITE.name}</span>
    </a>
    <ul class="flex flex-wrap gap-x-5 gap-y-1">
      {
        NAV.map((item) => (
          <li>
            <a
              href={item.href}
              class="annotation nav-link hover:text-figure"
              aria-current={
                item.file
                  ? undefined
                  : current === item.href
                    ? 'page'
                    : within === item.href
                      ? 'true'
                      : undefined
              }
              data-active={
                !item.file && (current === item.href || within === item.href)
                  ? 'true'
                  : undefined
              }
              data-file={item.file ? 'true' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  /*
   * 11px mono with no padding is a target well under the 24x24 minimum, and
   * these are the only navigation controls on the site. Padding gives them a
   * real hit area; the negative margin keeps the header the height it was.
   */
  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-block: -0.75rem;
    padding-block: 0.75rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    /* Same target floor as the nav items — it is a link to the index. */
    min-height: 44px;
    margin-block: -0.75rem;
    padding-block: 0.75rem;
  }

  .brand:hover .annotation {
    color: var(--color-figure);
  }

  /* `:global` — the glyph belongs to the imported SVG component's scope. */
  .brand__mark :global(svg) {
    display: block;
    height: 1.1rem;
    width: auto;
  }

  a[data-active='true'] {
    color: var(--color-figure);
    text-decoration: underline;
    text-underline-offset: 0.35em;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--color-accent);
  }
</style>
