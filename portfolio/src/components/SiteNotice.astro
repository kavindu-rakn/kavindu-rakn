---
import { getWork } from '../lib/work';

/*
 * Build-status strip.
 *
 * Renders only while case-study figures are still missing their media, and
 * removes itself the moment the last one is supplied — there is no flag to
 * remember to switch off, because the condition is derived from the content.
 *
 * Deliberately NOT an overlay or an interstitial. It is static text in the
 * normal flow, above the fold but below the header, so it costs nothing on the
 * largest-contentful-paint element, which on every page is body text.
 *
 * It uses the accent colour, not signal red.
 *
 * It states the outstanding count and nothing else. An earlier version claimed
 * "the deploy gate refuses to pass until every one is supplied", which was not
 * true — Vercel builds with the non-strict linter, so nothing blocked a deploy
 * carrying unresolved placeholders, and this strip only ever renders in exactly
 * the state that claim said was impossible. A banner asserting its own
 * impossibility is worse than no banner. Say the count; let the reader judge.
 *
 * It also claimed unfilled assets were "marked in red rather than quietly
 * hidden". That stopped being true when the hazard slots became dev-only, so it
 * is gone too. This count is now the whole of the public disclosure, which is
 * why it names a number rather than a vague state.
 *
 * Not `role="status"`: this is build-time static text, so a live region would
 * announce on every page load and never update.
 */

const work = await getWork();

const outstanding = work.reduce(
  (total, entry) =>
    total + (entry.data.figures?.filter((f) => !f.src && !f.video).length ?? 0),
  0,
);
---

{
  outstanding > 0 && (
    <aside class="notice" aria-label="Build status">
      <p class="notice__inner">
        <span class="notice__flag">In progress</span>
        <span class="notice__text">
          {outstanding} project {outstanding === 1 ? 'figure is' : 'figures are'} still
          being captured. Case-study imagery appears as each one lands.
        </span>
      </p>
    </aside>
  )
}

<style>
  .notice {
    border-bottom: 1px solid var(--color-rule);
    background-color: var(--color-ground-raised);
  }

  .notice__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.85rem;
    max-width: 72rem;
    margin-inline: auto;
    padding: 0.6rem 1.5rem;
  }

  .notice__flag {
    flex-shrink: 0;
    padding: 0.15rem 0.4rem;
    background-color: var(--color-accent);
    color: var(--color-ground);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .notice__text {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.6;
    color: var(--color-figure-muted);
  }
</style>
