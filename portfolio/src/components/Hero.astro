---
import { portfolioData } from '../data/portfolioData';
---

<section
  id="hero"
  class="relative min-h-svh flex flex-col justify-center max-w-6xl mx-auto px-6 pt-[calc(var(--header-height)+2rem)] pb-12 sm:pb-16"
>
  <div class="max-w-3xl space-y-8">
    <!-- The only h1 on the page. -->
    <h1 class="text-[2rem] leading-[1.15] sm:text-5xl md:text-7xl md:leading-[1.12] font-display font-medium tracking-tight text-metallic text-balance">
      <span class="inline-block">Creative Technologist</span>
      <span class="inline-block whitespace-nowrap"><span class="font-light">/</span>&nbsp;Design&nbsp;Engineer</span>
    </h1>

    <p class="text-lg sm:text-xl md:text-2xl text-[var(--text-secondary)] font-sans leading-relaxed max-w-2xl text-pretty">
      {portfolioData.identity.bioStatement}
    </p>

    <div class="pt-4 flex flex-wrap items-center gap-x-10 gap-y-4 text-sm sm:text-base font-mono">
      {
        [
          { href: '#works', label: 'Work' },
          { href: '#contact', label: 'Contact' },
        ].map(({ href, label }) => (
          <a
            href={href}
            class="link-underline group inline-flex items-center gap-2.5 py-2 text-[var(--text-primary)]"
          >
            {label}
            <span aria-hidden="true" class="inline-block transition-transform duration-300 group-hover:translate-y-0.5">↓</span>
          </a>
        ))
      }
    </div>
  </div>
</section>
