---
import { PLACEHOLDERS, type PlaceholderKey } from '../consts';

/*
 * An unfilled asset, rendered as a hazard label.
 *
 * BRIEF §5: "Placeholders for all of the above must be visually obvious in the
 * build so none of them can ship empty, exactly as the resume does with
 * [PHONE]." Signal red is reserved exclusively for this component — using it
 * decoratively anywhere else would dilute the alarm.
 *
 * `npm run lint:content` fails the build if any of these still resolve to null,
 * so this is a loud reminder during development and a hard gate before deploy.
 */

interface Props {
  /** Key into the PLACEHOLDERS registry. */
  of: PlaceholderKey;
  /**
   * Overrides the displayed token. Used where the content file carries the
   * literal token from the brief, e.g. `LIVE_URL_SCHEMASHIFT`.
   */
  token?: string;
  /** Inline form, for use inside a row of badges. */
  compact?: boolean;
  class?: string;
}

const { of, token, compact = false, class: className = '' } = Astro.props;
const spec = PLACEHOLDERS[of];
const shown = token ?? spec.token;
---

<span
  class:list={['placeholder', compact && 'placeholder--compact', className]}
  data-placeholder={spec.token}
>
  <span class="placeholder__flag">Placeholder</span>
  <code class="placeholder__token">{shown}</code>
  {!compact && <span class="placeholder__action">{spec.action}</span>}
</span>

<style>
  .placeholder {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.4rem 0.6rem;
    background-color: var(--color-signal-500);
    /* Near-black on signal red clears AA for normal text; white would not. */
    color: #0a0a0a;
    border: 2px solid #0a0a0a;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.35;
  }

  .placeholder--compact {
    padding: 0.2rem 0.4rem;
    font-size: 0.6875rem;
  }

  .placeholder__flag {
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .placeholder__flag::before {
    content: '▲ ';
  }

  .placeholder__token {
    font-weight: 500;
    letter-spacing: 0.04em;
    background-color: #0a0a0a;
    color: var(--color-signal-500);
    padding: 0.1rem 0.35rem;
  }

  .placeholder__action {
    flex: 1 1 16rem;
    min-width: 0;
  }
</style>
