---
import { portfolioData } from '../data/portfolioData';

const { socials } = portfolioData;
const year = new Date().getFullYear();
const home = Astro.url.pathname === '/' ? '' : '/';

// Each card is one large target: the link is stretched over the whole card.
const card =
  'group relative p-6 sm:p-8 rounded-lg border border-[var(--border-subtle)] hover:border-[var(--border-hover)] focus-within:border-[var(--border-hover)] bg-[var(--bg-surface)] transition-colors duration-300 flex flex-col justify-between gap-4 min-h-36';
const stretched =
  'self-start text-sm font-mono text-[var(--text-primary)] underline decoration-[var(--border-hover)] underline-offset-6 group-hover:decoration-[var(--text-primary)] transition-colors after:absolute after:inset-0 after:rounded-lg';
---

<footer id="contact" class="relative max-w-6xl w-full mx-auto px-6 min-h-[calc(100svh-var(--header-height))] flex flex-col border-t border-[var(--border-subtle)]">
  <div class="grow flex flex-col justify-center py-16 space-y-10 sm:space-y-12">
    <h2 class="text-3xl sm:text-4xl font-display font-medium text-[var(--text-primary)] tracking-tight">Connect</h2>

    <ul class="grid grid-cols-1 lg:grid-cols-3 gap-6" role="list">
      <li class={card}>
        <div class="flex items-start justify-between gap-3">
          <h3 class="text-xl font-display font-medium text-[var(--text-primary)]">Email</h3>
          <button
            id="copy-email"
            type="button"
            data-email={socials.email}
            class="relative z-10 -my-1 shrink-0 h-9 px-3.5 rounded-full border border-[var(--control-border)] bg-[var(--control-bg)] text-[var(--control-fg)] hover:text-[var(--text-primary)] hover:border-[var(--border-hover)] font-mono text-xs transition-[color,border-color,transform] duration-200 ease-[cubic-bezier(0.34,1.56,0.64,1)] active:scale-90 cursor-pointer"
          >
            <span data-label>Copy</span>
            <span class="sr-only"> email address</span>
          </button>
        </div>
        <a href={`mailto:${socials.email}`} class={stretched}>{socials.email}</a>
      </li>

      <li class={card}>
        <h3 class="text-xl font-display font-medium text-[var(--text-primary)]">GitHub</h3>
        <a href={socials.github} target="_blank" rel="noopener noreferrer" class={stretched}>
          github.com/<wbr /><span class="whitespace-nowrap">kavindu-rakn</span><span class="sr-only"> (opens in a new tab)</span>
        </a>
      </li>

      <li class={card}>
        <h3 class="text-xl font-display font-medium text-[var(--text-primary)]">LinkedIn</h3>
        <a href={socials.linkedin} target="_blank" rel="noopener noreferrer" class={stretched}>
          linkedin.com/in/<wbr /><span class="whitespace-nowrap">kavindu-ranathunga</span><span class="sr-only"> (opens in a new tab)</span>
        </a>
      </li>
    </ul>

    <p id="copy-status" class="sr-only" aria-live="polite"></p>
  </div>

  <div class="pb-8">
    <div class="px-6 py-4 rounded-lg bg-[var(--bg-header)] border border-[var(--border-subtle)] grid grid-cols-3 items-center text-xs sm:text-sm font-mono font-medium text-[var(--text-primary)]">
      <span class="text-left">{year} kvn</span>
      <a href="/llms.txt" class="justify-self-center py-2 hover:text-[var(--accent-chrome)] underline decoration-[var(--border-hover)] underline-offset-4 transition-colors">
        For AI
      </a>
      <a href={`${home}#hero`} class="justify-self-end py-2 hover:text-[var(--accent-chrome)] underline decoration-[var(--border-hover)] underline-offset-4 transition-colors">
        Home <span aria-hidden="true">↑</span>
      </a>
    </div>
  </div>
</footer>

<script>
  import { sound } from '../scripts/audioSynth';

  const button = document.getElementById('copy-email');
  const label = button?.querySelector<HTMLElement>('[data-label]');
  const status = document.getElementById('copy-status');
  let reset = 0;

  button?.addEventListener('click', async () => {
    const email = button.dataset.email ?? '';
    try {
      await navigator.clipboard.writeText(email);
    } catch {
      return; // Clipboard blocked: the mailto link beside it still works.
    }
    sound.playClick(1600, 0.03, 0.02);
    if (label) label.textContent = 'Copied ✓';
    if (status) status.textContent = 'Email address copied';
    clearTimeout(reset);
    reset = window.setTimeout(() => {
      if (label) label.textContent = 'Copy';
      if (status) status.textContent = '';
    }, 1800);
  });
</script>
