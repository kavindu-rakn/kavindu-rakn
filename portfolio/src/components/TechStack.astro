---
import Placeholder from './Placeholder.astro';

/*
 * Technology badges.
 *
 * ORDER IS LOAD-BEARING. CONTEXT §5: "Ordered by how central it is to his
 * actual work, not alphabetically." The array is rendered exactly as authored —
 * this component must never sort, dedupe or reorder.
 *
 * A badge here means the technology was used in the project being described. It
 * is not a capability claim — SKILLS in src/data/skills.ts is where those live,
 * and LEARNING in src/consts.ts is where in-progress ones do.
 */

interface Props {
  items?: readonly string[];
  placeholderToken?: string;
}

const { items, placeholderToken } = Astro.props;
---

{
  items ? (
    <ul class="flex flex-wrap gap-x-2 gap-y-2">
      {items.map((tech) => (
        <li class="border border-rule px-2 py-1 font-mono text-[0.6875rem] tracking-[0.12em] text-figure-muted uppercase">
          {tech}
        </li>
      ))}
    </ul>
  ) : (
    <Placeholder of="talenthubStack" token={placeholderToken} />
  )
}
