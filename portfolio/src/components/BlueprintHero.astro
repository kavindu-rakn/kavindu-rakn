---
import InteractiveBlueprint from './InteractiveBlueprint.astro';
import Wordmark from './Wordmark.astro';

/*
 * The cover.
 *
 * Replaces the static ASCII cover banner with an interactive kinematic blueprint
 * instrument. It reacts to pointer movement, touch, and clicks with dynamic
 * coordinate tracking, radial caliper geometry, and wave pulses, while keeping
 * the hero section compact so Selected Work arrives above the fold.
 */
---

<section class="border-b-2 border-figure">
  <div class="mx-auto max-w-6xl px-6 pt-10 pb-12 sm:pt-14 sm:pb-16">
    <header>
      <p class="annotation">Sheet 01 · Cover</p>
      {/*
        Weight 800, not 700: only 400/600/800 are shipped, so `font-bold`
        would make the browser synthesise a weight that does not exist.
      */}
      <h1
        class="mt-5 font-display text-[clamp(2.5rem,7vw,5.25rem)] leading-[0.92] font-extrabold tracking-[-0.025em]"
      >
        <Wordmark />
      </h1>
      <p class="mt-5 max-w-2xl text-base text-figure-muted sm:text-lg">
        Product engineer in Colombo. Every project below is a thing that had to
        work before it could look like anything.
      </p>
    </header>

    <div class="mt-8 sm:mt-12">
      <InteractiveBlueprint />
    </div>
  </div>
</section>
