---
import BlueprintSVG from './BlueprintSVG.astro';
import Wordmark from './Wordmark.astro';

/*
 * The hero, as an isolated script island.
 *
 * Load order, and why it is this order:
 *
 *   1. The heading and lede are plain server-rendered text. They paint first,
 *      so the LCP element is text and never the canvas.
 *   2. The static blueprint is already in the DOM as inline SVG. No request, no
 *      JavaScript. This is the whole experience for reduced-motion, low-power
 *      and no-JS visitors — a designed resting state, not a broken one.
 *   3. Only then does the gate run. If it passes, the raymarcher is dynamically
 *      imported inside requestIdleCallback, once the hero is near the viewport.
 *
 * The section is 160vh, not 240vh. The scroll span exists only to give the
 * camera somewhere to travel; two and a half screens of it meant the first
 * project sat below two full viewports of preamble.
 *
 * Nothing here is clickable. The previous hero navigated from a canvas click,
 * which is a link with no keyboard path, no focus ring, no middle-click and no
 * href in the status bar. Every one of those links exists properly in the grid
 * below, so the drawing is now honestly atmospheric.
 */
---

<section class="relative h-[160vh]" data-hero-section>
  <div
    class="sticky top-0 h-dvh overflow-hidden"
    data-hero-stage
    data-mode="static"
  >
    {/*
      Both visual layers are full-bleed and sit behind the text. The shader
      keeps its upper frame close to empty — the ground plane is below the
      camera and the plates are low — so the heading has clear paper to sit on
      without needing a scrim over the drawing.
    */}
    <div class="hero-layer hero-blueprint" aria-hidden="true">
      <BlueprintSVG />
    </div>
    <canvas class="hero-layer hero-canvas" data-hero-canvas aria-hidden="true"></canvas>

    <div
      class="relative z-10 mx-auto flex h-full w-full max-w-6xl flex-col px-6 pt-14 pb-8 sm:pt-20"
    >
      <header class="shrink-0">
        <p class="annotation">Sheet 01 · Blueprint space</p>
        {/*
          Weight 800, not 700: only 400/600/800 are shipped, so `font-bold`
          would make the browser synthesise a weight that does not exist.
        */}
        <h1
          class="mt-5 font-display text-[clamp(2.5rem,7vw,5.25rem)] leading-[0.92] font-extrabold tracking-[-0.025em]"
        >
          <Wordmark />
        </h1>
        <p class="mt-5 max-w-2xl text-base text-figure-muted sm:text-lg">
          Full-stack developer in Colombo. Six projects below, each one a thing
          that had to work before it could look like anything.
        </p>
      </header>

      <footer class="mt-auto shrink-0">
        <p class="annotation">Scroll</p>
      </footer>
    </div>
  </div>
</section>

<style>
  .hero-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-canvas {
    display: block;
    opacity: 0;
    transition: opacity 700ms ease;
  }

  /*
   * The fallback drawing sits low in the frame, under the text rather than
   * behind it, and stays quiet enough that the heading never fights it.
   */
  .hero-blueprint {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 0 1.5rem 4rem;
    opacity: 0.85;
    pointer-events: none;
    transition: opacity 700ms ease;
  }

  .hero-blueprint :global(svg) {
    width: 100%;
    max-width: 56rem;
    height: auto;
    max-height: 62%;
  }

  /* Crossfade once the first frame has actually been drawn. */
  [data-mode='live'] .hero-canvas {
    opacity: 1;
  }
  [data-mode='live'] .hero-blueprint {
    opacity: 0;
  }
</style>

<script>
  import type { BootContext } from '../scripts/blueprint-hero';

  const section = document.querySelector<HTMLElement>('[data-hero-section]');
  const stage = document.querySelector<HTMLElement>('[data-hero-stage]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');

  /**
   * Capability gate. Detect capability, not screen width — most of the audience
   * for this site is on mid-range Android, and a hero that janks is worse than
   * no hero. Raymarching is fragment-bound, so this matters more here than it
   * did for the mesh scene it replaces.
   */
  function webgl2Available(): boolean {
    try {
      const probe = document.createElement('canvas');
      return Boolean(probe.getContext('webgl2'));
    } catch {
      return false;
    }
  }

  function shouldRender3D(): boolean {
    // No exceptions, and no "reduced but still moving" compromise.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return false;

    // 0/undefined means the browser will not say. Do not penalise for that.
    const cores = navigator.hardwareConcurrency ?? 0;
    const memory =
      (navigator as Navigator & { deviceMemory?: number }).deviceMemory ?? 0;
    if (cores > 0 && cores <= 3) return false;
    if (memory > 0 && memory < 4) return false;

    return webgl2Available();
  }

  function whenIdle(run: () => void): void {
    // `typeof` rather than `'x' in window`: the `in` form narrows Window itself
    // to `never` in the else branch, because the lib types always declare it.
    if (typeof window.requestIdleCallback === 'function') {
      window.requestIdleCallback(run, { timeout: 2000 });
    } else {
      window.setTimeout(run, 200);
    }
  }

  if (section && stage && canvas && shouldRender3D()) {
    let teardown: (() => void) | null = null;

    // Do not even fetch the renderer until the hero is close to the viewport.
    const loader = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        loader.disconnect();

        whenIdle(async () => {
          try {
            const { boot } = await import('../scripts/blueprint-hero');
            const context: BootContext = { canvas, stage, section };
            teardown = boot(context);
          } catch (error) {
            // Any failure leaves the static blueprint in place, which is a
            // complete experience on its own. In development it also says so —
            // a silent catch here once hid a shader compile error behind a
            // fallback that looked deliberate.
            if (import.meta.env.DEV) console.error('[hero] boot failed', error);
            stage.dataset.mode = 'static';
          }
        });
      },
      { rootMargin: '200px' },
    );

    loader.observe(stage);

    window.addEventListener('pagehide', () => {
      teardown?.();
      teardown = null;
    });
  }
</script>
