---
import InteractiveBlueprint from './InteractiveBlueprint.astro';
import Wordmark from './Wordmark.astro';

/*
 * The cover.
 *
 * Expands to fully occupy the initial viewport height on desktop, providing
 * substantial canvas real estate for the interactive kinematic drafting instrument
 * while placing the Selected Work separator cleanly at the fold.
 */
---

<section class="border-b-2 border-figure min-h-[calc(100svh-3.5rem)] flex flex-col justify-between">
  <div class="mx-auto flex w-full max-w-6xl flex-1 flex-col justify-between px-6 pt-8 pb-10 sm:pt-10 sm:pb-12">
    <header>
      <p class="annotation">Sheet 01 · Cover</p>
      {/*
        Weight 800, not 700: only 400/600/800 are shipped, so `font-bold`
        would make the browser synthesise a weight that does not exist.
      */}
      <h1
        class="mt-4 font-display text-[clamp(2.5rem,7vw,5.25rem)] leading-[0.92] font-extrabold tracking-[-0.025em]"
      >
        <Wordmark />
      </h1>
      <p class="mt-4 max-w-2xl text-base text-figure-muted sm:text-lg">
        Product engineer in Colombo. Every project below is a thing that had to
        work before it could look like anything.
      </p>
    </header>

    <div class="mt-6 flex flex-1 flex-col justify-center sm:mt-8">
      <InteractiveBlueprint />
    </div>
  </div>
</section>
