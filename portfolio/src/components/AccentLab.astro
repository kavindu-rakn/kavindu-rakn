---
/*
 * TEMPORARY — the last open question: lime or chartreuse for dark mode.
 *
 * Rendered only when `import.meta.env.DEV` is true, so it cannot reach a build.
 * Delete this file and its one line in Layout.astro once dark is settled.
 *
 * Light is finished: gold, 6.5:1 against the near-black ink. It is set in
 * global.css and is not switchable here any more.
 *
 * The two numbers matter for different reasons, and in dark mode they pull
 * against each other. `vs ground` is how hard the colour pops off the black —
 * lime wins that outright. `vs ink` is how far it stays from the WHITE text,
 * and that is where lime is thin at 1.38. The risk inverts between the modes:
 * in light a bad accent disappears into black type, in dark it disappears into
 * white type. Chartreuse trades 3.4 points of ground separation for half a
 * point more distance from the text.
 *
 * Where to judge it: the "In progress" flag, where the accent is a filled block
 * behind ground-coloured text, and the Contact block's border against the seven
 * project cards. Those are the two places the accent does structural work
 * rather than decoration.
 *
 * The rules are wrapped in a dark-mode media query, and that is load-bearing:
 * unwrapped they would apply in light mode too, and `html:has()` at (1,1,1)
 * beats `:root` at (0,1,0), so they would silently replace the settled gold —
 * which is exactly the bug that hid lime last round. Specificity decides this,
 * not source order.
 */

const DARK = [
  ['lime', '#c3e640', 'Lime', '13.9', '1.38'],
  ['chartreuse', '#9acd32', 'Chartreuse', '10.5', '1.82'],
] as const;
---

<form class="accent-lab" aria-label="Dark accent preview (development only)">
  <p class="accent-lab__title">Dark accent · dev only</p>

  <p class="accent-lab__legend">
    <span>ground</span>
    <span>ink</span>
  </p>

  {
    DARK.map(([id, hex, label, ground, ink], i) => (
      <label class="accent-lab__row">
        <input type="radio" name="accent-dark" id={`dk-${id}`} checked={i === 0} />
        <i class="accent-lab__chip" style={`background:${hex}`} />
        <span class="accent-lab__name">{label}</span>
        <b class="accent-lab__sep">{ground}</b>
        <b class="accent-lab__sep">{ink}</b>
      </label>
    ))
  }

  <p class="accent-lab__note">Light settled: gold · 6.5 vs ink</p>
</form>

{/*
  `is:global`: the selector targets <html>, which never carries a component's
  scope attribute, so a scoped rule would match nothing and fail silently.
*/}
<style
  is:global
  set:html={`@media (prefers-color-scheme: dark) {
${DARK.map(([id, hex]) => `html:has(#dk-${id}:checked){--color-accent:${hex};}`).join('\n')}
}`}
/>

<style>
  .accent-lab {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 100;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 0.75rem 0.9rem;
    background-color: var(--color-ground);
    border: 2px solid var(--color-figure);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-figure);
  }

  .accent-lab__title {
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-figure-muted);
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--color-rule);
  }

  .accent-lab__legend {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    font-size: 0.5625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-figure-muted);
  }

  .accent-lab__legend span {
    width: 2.6rem;
    text-align: right;
  }

  .accent-lab__row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
  }

  .accent-lab__name {
    min-width: 5.5rem;
  }

  .accent-lab__sep {
    width: 2.6rem;
    text-align: right;
    font-weight: 400;
    color: var(--color-figure-muted);
  }

  .accent-lab__note {
    margin-top: 0.2rem;
    padding-top: 0.4rem;
    border-top: 1px solid var(--color-rule);
    color: var(--color-figure-muted);
  }

  .accent-lab__chip {
    display: block;
    width: 0.95rem;
    height: 0.95rem;
    border: 1px solid var(--color-rule);
  }
</style>
