---
/*
 * TEMPORARY — a switch for trying accents against the real site.
 *
 * Rendered only when `import.meta.env.DEV` is true, so it cannot reach a build.
 * Delete this file and its one line in Layout.astro once a pair is chosen.
 *
 * Dark is settled — lime, which clears about 14:1 against the near-black
 * ground. Only the light accent is still open, and the number beside each swatch
 * is its contrast against the ink. That column is the whole point: every colour
 * rejected so far sat between 1.6 and 2.7, which is why they all read as black
 * whatever their hue. Nothing here is below 4.8.
 *
 * The trade is fixed by the two grounds: ratio-to-ink times ratio-to-cream is
 * roughly constant, so separating harder from black necessarily means sitting
 * lighter on the paper. Higher up this list is bolder against the text and
 * fainter against the page.
 *
 * No JavaScript. `html:has(:checked)` re-points --color-accent, and every accent
 * on the site resolves through that one token, so the whole page follows.
 *
 * The rules are wrapped in a light-mode media query, and that is load-bearing.
 * Unwrapped they applied in dark mode as well, and because `html:has()` scores
 * (1,1,1) against `:root`'s (0,1,0) they beat the stylesheet outright — so the
 * light pick silently replaced the dark accent. Specificity decides this, not
 * source order, which is exactly what the earlier comment here got wrong.
 */

const LIGHT = [
  ['chartreuse', '#9acd32', 'Chartreuse', '10.1'],
  ['amber', '#e0a21a', 'Amber', '8.5'],
  ['mustard', '#d4a017', 'Mustard', '8.0'],
  ['olive', '#7cb518', 'Olive', '7.7'],
  ['orchid', '#c77dff', 'Orchid', '7.1'],
  ['gold', '#ca8a04', 'Gold', '6.5'],
  ['brass', '#b8860b', 'Brass', '5.8'],
  ['violet', '#a855f7', 'Violet', '4.8'],
] as const;
---

<form class="accent-lab" aria-label="Accent preview (development only)">
  <p class="accent-lab__title">Accent lab · dev only</p>

  <fieldset class="accent-lab__group">
    <legend>Light accent · x:1 vs ink</legend>
    {
      LIGHT.map(([id, hex, label, sep], i) => (
        <label class="accent-lab__row">
          <input type="radio" name="accent-light" id={`lt-${id}`} checked={i === 0} />
          <i class="accent-lab__chip" style={`background:${hex}`} />
          <span>{label}</span>
          <b class="accent-lab__sep">{sep}</b>
        </label>
      ))
    }
  </fieldset>

</form>

{/*
  `is:global` and `set:html`: the selector targets <html>, which never carries a
  component's scope attribute, so a scoped rule would match nothing and fail
  silently — which is exactly how the parallax script died.
*/}
<style
  is:global
  set:html={`@media (prefers-color-scheme: light) {\n${LIGHT.map(([id, hex]) => `html:has(#lt-${id}:checked){--color-accent:${hex};}`).join('\n')}\n}`}
/>

<style>
  .accent-lab {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 100;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    max-height: 90vh;
    overflow-y: auto;
    padding: 0.75rem 0.9rem;
    background-color: var(--color-ground);
    border: 2px solid var(--color-figure);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-figure);
  }

  .accent-lab__title {
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-figure-muted);
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--color-rule);
  }

  .accent-lab__group {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    border: 0;
    padding: 0;
    margin: 0;
  }

  .accent-lab__group legend {
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-figure-muted);
    padding-bottom: 0.3rem;
  }

  .accent-lab__row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
  }

  .accent-lab__sep {
    margin-left: auto;
    font-weight: 400;
    color: var(--color-figure-muted);
  }

  .accent-lab__chip {
    display: block;
    width: 0.95rem;
    height: 0.95rem;
    border: 1px solid var(--color-rule);
  }
</style>
