---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SkillsMatrix from '../components/SkillsMatrix.astro';
import ContactBlock from '../components/ContactBlock.astro';
import {
  SITE,
  AVAILABILITY,
  LEARNING,
  LATEST_ROLE,
  currentRole,
  elapsedPhrase,
} from '../consts';

/*
 * Every number here is a raw count. No percentages, no hours, no
 * self-description — `npm run lint:content` enforces that.
 *
 * Two kinds of duration appear on this page and they must not be confused:
 *
 *   - The *floating* figure (`elapsed`) means "how long he has been building",
 *     and has to track today. It is derived from FIRST_COMMIT and refreshed by
 *     the scheduled rebuild in .github/workflows/refresh.yml — never typed.
 *   - *Fixed* figures describe a milestone that already happened and must stay
 *     put. Those are marked `duration-ok` so the linter leaves them alone.
 */
const elapsed = elapsedPhrase();
const held = currentRole();

const description = `First commit 17 August 2025. ${elapsed} later, core contributor rebuilding 27 production screens on a platform built by twenty developers.`;
---

<Layout title="About" description={description}>
  <SiteHeader slot="header" current="/about" />

  <div class="mx-auto max-w-6xl px-6 py-16 sm:py-24">
    <nav
      class="mb-6 flex flex-wrap items-center gap-2 font-mono text-xs text-figure-muted"
      aria-label="Breadcrumb"
    >
      <a href="/" class="hover:text-figure transition-colors">Home</a>
      <span class="opacity-40">/</span>
      <span class="text-figure font-medium">Sheet 00</span>
      <span class="opacity-40">·</span>
      <span>Career & Practice</span>
    </nav>

    <h1
      class="display-title mt-2 text-4xl sm:text-6xl lg:text-7xl leading-[0.9] break-words"
    >
      {elapsed}
    </h1>

    <p class="mt-5 max-w-2xl text-lg sm:text-xl text-figure-muted leading-relaxed">
      First commit August 2025. Core contributor to enterprise production systems, builder of schema engines, and WebGL instruments.
    </p>

    <div class="prose-blueprint mt-12">
      <p>
        My first commit was on <strong>17 August 2025</strong>. Before the internship
        at Sri Lanka Telecom Mobitel I had not used git.
      </p>

      {/* duration-ok — a fixed milestone. This one must not track today. */}
      <p>
        Twelve months after that first commit I was a core contributor to
        TalentHub, a platform in production that twenty developers built over a year
        — <strong>37 pull requests merged to main</strong> and rebuilding the interface
        across <strong>27 of its 35 screens</strong>. In that same year I designed and
        shipped five projects of my own.
      </p>

      <p>
        That is the whole of it. The GitHub history is short because it starts in
        August 2025, and everything in it was written in the {elapsed.toLowerCase()} since.
      </p>

      <h2>What the work has in common</h2>

      <p>
        SchemaShift shows you the consequences of a schema change before you commit
        it. Horologia takes a sealed mechanism apart so you can see how it drives
        itself. Luna computes real orbital positions instead of drawing a picture of
        a moon.
      </p>

      <p>
        Each one takes something that normally happens out of sight and puts it on
        screen. That is the kind of problem I look for.
      </p>
    </div>

    <!-- Career Milestones & Technical Spec Plate -->
    <div class="mt-14 border border-rule bg-ground-raised p-6 sm:p-8">
      <div class="flex items-center justify-between border-b border-rule pb-3">
        <span class="annotation text-accent">// Current Status & Credentials</span>
        <span class="annotation font-mono text-xs text-figure-muted">Plate 00-A</span>
      </div>

      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        <div>
          <span class="annotation block text-[11px] text-figure-muted">Production Track Record</span>
          <p class="mt-1 font-display text-base sm:text-lg font-semibold text-figure">
            {held ? `${held.title}, ${held.org}` : `${LATEST_ROLE.title}, ${LATEST_ROLE.org}`}
          </p>
          <span class="annotation font-mono text-xs text-figure-muted mt-1 block">
            {held ? held.period : LATEST_ROLE.period} · 37 merged PRs
          </span>
        </div>

        <div>
          <span class="annotation block text-[11px] text-figure-muted">Degree & Academic Foundation</span>
          <p class="mt-1 font-display text-base sm:text-lg font-semibold text-figure">
            BSc (Hons) Information Technology
          </p>
          <span class="annotation font-mono text-xs text-figure-muted mt-1 block">
            Software Engineering · SLIIT (2022–2027)
          </span>
        </div>

        <div>
          <span class="annotation block text-[11px] text-figure-muted">Location</span>
          <p class="mt-1 font-display text-base sm:text-lg font-semibold text-figure">
            {SITE.location}
          </p>
          <span class="annotation font-mono text-xs text-figure-muted mt-1 block">
            Available on-site & remote worldwide
          </span>
        </div>

        <div>
          <span class="annotation block text-[11px] text-figure-muted">Engineering Availability</span>
          <p class="mt-1 font-display text-base sm:text-lg font-semibold text-accent">
            {AVAILABILITY}
          </p>
          <span class="annotation font-mono text-xs text-figure-muted mt-1 block">
            Full-time, contract & internship roles
          </span>
        </div>
      </div>

      {LEARNING.length > 0 && (
        <div class="mt-6 border-t border-rule/60 pt-4 flex flex-wrap items-center gap-2">
          <span class="annotation text-[11px] text-figure-muted mr-2">Focus Areas:</span>
          {LEARNING.map((tech) => (
            <span class="border border-rule px-2 py-0.5 font-mono text-xs text-figure">
              {tech}
            </span>
          ))}
        </div>
      )}
    </div>

    <div class="prose-blueprint mt-10">
      <p>
        The fastest way to judge any of this is to read the code or run the projects.
        Both are indexed on the <a class="rule-link rule-link--internal text-sm inline-block" href="/#work">Selected work</a>; for the two private
        repositories, source is available on request.
      </p>
    </div>

    <div class="mt-20">
      <SkillsMatrix headingLevel="h2" />
    </div>

    <div class="mt-20">
      <ContactBlock compact />
    </div>
  </div>

  <SiteFooter slot="footer" compact />
</Layout>
