---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import BlueprintHero from '../components/BlueprintHero.astro';
import { SITE } from '../consts';

/*
 * Phase 2: the hero is real. Everything below it is still scaffolding — Phase 3
 * replaces the list with the brutalist project grid.
 */
const work = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout title={SITE.name}>
  <BlueprintHero />

  <section class="border-t border-rule">
    <div class="mx-auto max-w-6xl px-6 py-24">
      <p class="annotation">Phase 3 · Project grid goes here</p>

      <ul class="mt-8 space-y-8">
        {
          work.map((entry) => (
            <li class="border-l-2 border-accent pl-4">
              <h2 class="font-display text-2xl font-semibold">{entry.data.title}</h2>
              {entry.data.tagline && (
                <p class="mt-1 text-figure-muted">{entry.data.tagline}</p>
              )}
              <ul class="mt-3 flex flex-wrap gap-2">
                {entry.data.techStack.map((tech) => (
                  <li class="annotation border border-rule px-2 py-1">{tech}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>
