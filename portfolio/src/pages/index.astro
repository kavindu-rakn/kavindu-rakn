---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { SITE } from '../consts';

/*
 * PHASE 1 SCAFFOLD ONLY.
 *
 * This page exists to prove the pipeline end to end: Tailwind 4 compiles, the
 * semantic tokens invert on prefers-color-scheme, the Layout emits correct SEO,
 * and the `work` collection loads and type-checks. Phase 3 replaces it with the
 * real grid, and Phase 2 mounts the 3D island above it.
 */
const work = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout title={SITE.name}>
  <div class="blueprint-grid min-h-dvh">
    <div class="mx-auto max-w-5xl px-6 py-24">
      <p class="annotation">Phase 1 · scaffold verification</p>

      <h1
        class="mt-6 font-display text-5xl leading-[0.95] font-bold tracking-tight sm:text-7xl"
      >
        {SITE.name}
      </h1>
      <p class="mt-4 max-w-xl text-lg text-figure-muted">
        {SITE.role} · {SITE.location}
      </p>

      <hr class="my-12 border-0 border-t border-rule" />

      <p class="annotation">Work collection · {work.length} loaded</p>
      <ul class="mt-6 space-y-6">
        {
          work.map((entry) => (
            <li class="border-l-2 border-accent pl-4">
              <h2 class="font-display text-2xl font-semibold">{entry.data.title}</h2>
              {entry.data.tagline && (
                <p class="mt-1 text-figure-muted">{entry.data.tagline}</p>
              )}
              <ul class="mt-3 flex flex-wrap gap-2">
                {entry.data.techStack.map((tech) => (
                  <li class="annotation border border-rule px-2 py-1">{tech}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Layout>
