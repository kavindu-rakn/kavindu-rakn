---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found · Kavindu Ranathunga" description="This page does not exist." noindex>
  <section class="min-h-[calc(100svh-var(--header-height))] flex flex-col justify-center max-w-6xl mx-auto px-6 pt-[var(--header-height)]">
    <p class="font-mono text-sm text-[var(--text-tertiary)]">404</p>
    <h1 class="mt-4 text-4xl sm:text-6xl font-display font-medium tracking-tight text-metallic">Nothing here.</h1>
    <a
      href="/"
      class="mt-10 self-start inline-flex items-center gap-2.5 py-2 font-mono text-[var(--text-primary)] underline decoration-[var(--border-hover)] underline-offset-6 hover:text-[var(--accent-chrome)] transition-colors"
    >
      <span aria-hidden="true">←</span> Home
    </a>
  </section>
</BaseLayout>
