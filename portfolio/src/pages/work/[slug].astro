---
import { render } from 'astro:content';
import { getWork } from '../../lib/work';
import Figure from '../../components/Figure.astro';
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import TechStack from '../../components/TechStack.astro';

import { STATUS_LABEL } from '../../consts';

/*
 * One route per entry in the `work` collection.
 *
 * Routes come from the same helper the grid and the 404 recovery list use, so
 * a link in either can never point at a page that was not generated.
 */
export async function getStaticPaths() {
  const entries = await getWork();
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: entries[i - 1] ?? null,
      next: entries[i + 1] ?? null,
    },
  }));
}

// No `interface Props` here: on a dynamic route Astro infers the prop types
// from getStaticPaths, and declaring them again is dead code.
/*
 * Imagery renders when at least one figure resolves, and in dev regardless — so
 * the hazard slots stay loud while the captures are being produced, and a public
 * page never shows a reader eleven pictures of a missing picture.
 *
 * Suppressing them in production removed what the strict linter used to detect,
 * because it looked for the SCREENSHOT_REQUIRED token in the built HTML. That
 * check now reads the frontmatter instead (scripts/lint-content.mjs), so the
 * deploy gate is unchanged by this and the outstanding count in the build strip
 * still comes from the same content.
 */
const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);

/*
 * Only pages that actually carry a recording get the player script, and it is
 * `is:inline` so it is emitted where it is written rather than hoisted into a
 * module every case study would then have to fetch. Pages without video keep
 * shipping zero JavaScript.
 */
const hasVideo = entry.data.figures?.some((f) => f.video) ?? false;

/*
 * Imagery is grouped by viewport, not left in author order: three desktop
 * captures stacked at full width, then the three phone captures side by side
 * beneath them. A 9:16 capture at full width is a column of screen taller than
 * the viewport, and three of them stacked would be most of a page of scrolling;
 * in a row they read as one comparison and balance the block above.
 *
 * Plate letters are assigned over the whole set in this display order, so
 * "Plate 04-D" always means the first phone capture on Sheet 04.
 */
const shown = (entry.data.figures ?? []).filter(
  (f) => f.src || f.video || import.meta.env.DEV,
);
const desktopFigures = shown.filter((f) => f.viewport !== 'mobile');
const mobileFigures = shown.filter((f) => f.viewport === 'mobile');
const plateFor = (i: number) =>
  `${String(entry.data.order).padStart(2, '0')}-${String.fromCharCode(65 + i)}`;
const d = entry.data;

---

<Layout
  title={d.title}
  description={d.description}
  ogType="article"
  ogImage={d.ogImage?.src ?? `/og/${entry.id}.png`}
  ogImageAlt={`${d.title} — ${d.tagline ?? 'case study'}`}
>
  {/* Under Work, not Work itself — see the `within` prop. */}
  <SiteHeader slot="header" within="/#work" />

  <article class="mx-auto max-w-6xl px-6 py-12 sm:py-20">
    <nav
      class="mb-6 flex flex-wrap items-center gap-2 font-mono text-xs text-figure-muted"
      aria-label="Breadcrumb"
    >
      <a href="/#work" class="hover:text-figure transition-colors">Work</a>
      <span class="opacity-40">/</span>
      <span class="text-figure font-semibold">Sheet {String(d.order).padStart(2, '0')}</span>
      <span class="opacity-40">·</span>
      <span>{STATUS_LABEL[d.status]}</span>
      {
        (entry.id === 'schemashift' || entry.id === 'talenthub') && (
          <span class="ml-2 font-mono text-[10px] font-bold px-2 py-0.5 border border-accent bg-accent/10 text-accent tracking-wider">
            FLAGSHIP CASE STUDY
          </span>
        )
      }
    </nav>

    <h1
      class="display-title mt-2 text-4xl sm:text-6xl lg:text-7xl leading-[0.9] break-words"
    >
      {d.title}
    </h1>

    {
      d.tagline && (
        <p class="mt-5 max-w-3xl text-lg sm:text-xl text-figure-muted leading-relaxed">{d.tagline}</p>
      )
    }

    <div class="mt-8">
      <TechStack items={d.techStack} />
    </div>

    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
      {
        d.liveUrl && (
          <a
            class="rule-link rule-link--strong inline-flex items-center gap-1.5"
            href={d.liveUrl}
            rel="noopener noreferrer"
            target="_blank"
          >
            <span>Live deployment</span>
            <span class="text-accent font-mono" aria-hidden="true">&nearr;</span>
          </a>
        )
      }
      {
        d.githubUrl && (
          <a
            class="rule-link inline-flex items-center gap-1.5"
            href={d.githubUrl}
            rel="noopener noreferrer"
            target="_blank"
          >
            <span>GitHub repository</span>
            <span class="text-accent font-mono" aria-hidden="true">&nearr;</span>
          </a>
        )
      }
      {d.sourcePrivate && <span class="annotation">Source private · available on request</span>}
      {d.employment && !d.githubUrl && !d.liveUrl && (
        <span class="annotation">Internal platform · no public repository</span>
      )}
    </div>

    {
      shown.length > 0 && (
        <section class="mt-16">
          <p class="annotation border-b border-rule pb-3">Imagery</p>

          {desktopFigures.length > 0 && (
            <div class="mt-6 space-y-8">
              {desktopFigures.map((figure, i) => (
                <Figure figure={figure} plate={plateFor(i)} />
              ))}
            </div>
          )}

          {mobileFigures.length > 0 && (
            <div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-6">
              {mobileFigures.map((figure, i) => (
                <Figure figure={figure} plate={plateFor(desktopFigures.length + i)} />
              ))}
            </div>
          )}
        </section>
      )
    }

    <div class="prose-blueprint mt-16">
      <Content />
    </div>

    <nav
      class="mt-24 border-t-2 border-figure pt-8"
      aria-label="Case study pagination"
    >
      <div class="grid gap-4 sm:grid-cols-2">
        {
          prev ? (
            <a class="sibling-card sibling-card--prev group" href={`/work/${prev.id}`}>
              <span class="annotation flex items-center gap-1.5 text-figure-muted group-hover:text-accent transition-colors">
                &larr; Sheet {String(prev.data.order).padStart(2, '0')} · Previous
              </span>
              <span class="sibling-card__title mt-1.5 block font-display text-xl sm:text-2xl font-bold tracking-tight text-figure group-hover:text-accent transition-colors">
                {prev.data.title}
              </span>
            </a>
          ) : (
            <div class="hidden sm:block" />
          )
        }
        {
          next ? (
            <a class="sibling-card sibling-card--next group sm:text-right" href={`/work/${next.id}`}>
              <span class="annotation flex items-center justify-start sm:justify-end gap-1.5 text-figure-muted group-hover:text-accent transition-colors">
                Sheet {String(next.data.order).padStart(2, '0')} · Next &rarr;
              </span>
              <span class="sibling-card__title mt-1.5 block font-display text-xl sm:text-2xl font-bold tracking-tight text-figure group-hover:text-accent transition-colors">
                {next.data.title}
              </span>
            </a>
          ) : (
            <div class="hidden sm:block" />
          )
        }
      </div>

      <div class="mt-8 flex items-center justify-between border-t border-rule pt-4">
        <a class="rule-link rule-link--internal text-sm inline-flex items-center gap-1.5" href="/#work">
          <span>&uarr; Back to Selected Work</span>
        </a>
        <span class="annotation font-mono text-[11px] text-figure-muted">
          Sheet {String(d.order).padStart(2, '0')} of 07
        </span>
      </div>
    </nav>
  </article>

  {
    hasVideo && (
      <script is:inline>
      // Autoplay is added here, never in the markup: HTML cannot express
      // "loop unless the visitor asked for less motion". No permission, no
      // JS, or a failed play() all leave the poster and its play button.
      if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.play().catch(function () {}); }
            else { e.target.pause(); }
          });
        }, { threshold: 0.25 });
        document.querySelectorAll('video[data-autoplay]').forEach(function (v) {
          v.autoplay = true;
          io.observe(v);
        });
      }
      </script>
    )
  }

  <SiteFooter slot="footer" />
</Layout>

<style>
  .sibling-card {
    display: block;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--color-rule);
    background-color: var(--color-ground-raised);
    transition: border-color 150ms ease, background-color 150ms ease;
  }
  .sibling-card:hover {
    border-color: var(--color-accent);
  }
</style>
