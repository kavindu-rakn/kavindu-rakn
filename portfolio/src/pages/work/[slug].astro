---
import { render } from 'astro:content';
import { getWork } from '../../lib/work';
import Figure from '../../components/Figure.astro';
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import TechStack from '../../components/TechStack.astro';

import { STATUS_LABEL } from '../../consts';

/*
 * One route per entry in the `work` collection.
 *
 * Routes come from the same helper the grid and the 404 recovery list use, so
 * a link in either can never point at a page that was not generated.
 */
export async function getStaticPaths() {
  const entries = await getWork();
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: entries[i - 1] ?? null,
      next: entries[i + 1] ?? null,
    },
  }));
}

// No `interface Props` here: on a dynamic route Astro infers the prop types
// from getStaticPaths, and declaring them again is dead code.
/*
 * Imagery renders when at least one figure resolves, and in dev regardless — so
 * the hazard slots stay loud while the captures are being produced, and a public
 * page never shows a reader eleven pictures of a missing picture.
 *
 * Suppressing them in production removed what the strict linter used to detect,
 * because it looked for the SCREENSHOT_REQUIRED token in the built HTML. That
 * check now reads the frontmatter instead (scripts/lint-content.mjs), so the
 * deploy gate is unchanged by this and the outstanding count in the build strip
 * still comes from the same content.
 */
const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);

/*
 * Only pages that actually carry a recording get the player script, and it is
 * `is:inline` so it is emitted where it is written rather than hoisted into a
 * module every case study would then have to fetch. Pages without video keep
 * shipping zero JavaScript.
 */
const hasVideo = entry.data.figures?.some((f) => f.video) ?? false;
const d = entry.data;

---

<Layout
  title={d.title}
  description={d.description}
  ogType="article"
  ogImage={d.ogImage?.src ?? `/og/${entry.id}.png`}
  ogImageAlt={`${d.title} — ${d.tagline ?? 'case study'}`}
>
  {/* Under Work, not Work itself — see the `within` prop. */}
  <SiteHeader slot="header" within="/#work" />

  <article class="mx-auto max-w-6xl px-6 py-16 sm:py-24">
    <p class="annotation">
      Sheet {String(d.order).padStart(2, '0')} · {STATUS_LABEL[d.status]}
    </p>

    <h1
      class="mt-6 font-display text-5xl leading-[0.88] font-extrabold tracking-[-0.025em] uppercase sm:text-7xl"
    >
      {d.title}
    </h1>

    {
      d.tagline && (
        <p class="mt-6 max-w-2xl text-lg text-figure-muted sm:text-xl">{d.tagline}</p>
      )
    }

    <div class="mt-10">
      <TechStack items={d.techStack} />
    </div>

    <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3">
      {
        d.liveUrl && (
          <a class="study-link" href={d.liveUrl} rel="noopener noreferrer" target="_blank">
            Live site
          </a>
        )
      }
      {
        d.githubUrl && (
          <a class="study-link" href={d.githubUrl} rel="noopener noreferrer" target="_blank">
            Source
          </a>
        )
      }
      {d.sourcePrivate && <span class="annotation">Source private · available on request</span>}
      {d.employment && !d.githubUrl && !d.liveUrl && (
        <span class="annotation">Internal platform · no public repository</span>
      )}
    </div>

    {
      d.figures && d.figures.some((f) => f.src || f.video || import.meta.env.DEV) && (
        <section class="mt-16">
          <p class="annotation border-b border-rule pb-3">Imagery</p>
          <div class="mt-6 space-y-8">
            {d.figures
              .filter((figure) => figure.src || figure.video || import.meta.env.DEV)
              .map((figure) => (
                <Figure figure={figure} />
              ))}
          </div>
        </section>
      )
    }

    <div class="prose-blueprint mt-16">
      <Content />
    </div>

    <nav
      class="mt-24 grid gap-6 border-t-2 border-figure pt-6 sm:grid-cols-2"
      aria-label="Case studies"
    >
      <div>
        {
          prev && (
            <a class="sibling" href={`/work/${prev.id}`}>
              <span class="annotation">Previous</span>
              <span class="sibling__title">{prev.data.title}</span>
            </a>
          )
        }
      </div>
      <div class="sm:text-right">
        {
          next && (
            <a class="sibling" href={`/work/${next.id}`}>
              <span class="annotation">Next</span>
              <span class="sibling__title">{next.data.title}</span>
            </a>
          )
        }
      </div>
    </nav>

    <p class="mt-10">
      <a class="study-link study-link--internal" href="/#work">All work</a>
    </p>
  </article>

  {
    hasVideo && (
      <script is:inline>
        {`
          // Autoplay is added here, never in the markup: HTML cannot express
          // "loop unless the visitor asked for less motion". No permission, no
          // JS, or a failed play() all leave the poster and its play button.
          if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
            var io = new IntersectionObserver(function (entries) {
              entries.forEach(function (e) {
                if (e.isIntersecting) { e.target.play().catch(function () {}); }
                else { e.target.pause(); }
              });
            }, { threshold: 0.25 });
            document.querySelectorAll('video[data-autoplay]').forEach(function (v) {
              v.autoplay = true;
              io.observe(v);
            });
          }
        `}
      </script>
    )
  }

  <SiteFooter slot="footer" />
</Layout>

<style>
  .study-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-figure);
    text-decoration: underline;
    text-underline-offset: 0.35em;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--color-accent);
  }
  .study-link::after {
    content: ' ↗';
    text-decoration: none;
  }
  .study-link--internal::after {
    content: ' →';
  }
  .study-link:hover {
    color: var(--color-accent);
  }

  .sibling {
    display: block;
  }
  .sibling__title {
    display: block;
    margin-top: 0.4rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
  }
  .sibling:hover .sibling__title {
    color: var(--color-accent);
  }
</style>
